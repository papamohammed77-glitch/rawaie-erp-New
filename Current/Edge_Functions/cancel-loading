import { serve } from "https://deno.land/std@0.168.0/http/server.ts"; import { createClient } from "https://esm.sh/@supabase/supabase-js@2"; const s=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!); const h={"Access-Control-Allow-Origin":"*","Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type","Access-Control-Allow-Methods":"POST, OPTIONS"}; serve(async(req)=>{if(req.method==='OPTIONS')return new Response('ok',{headers:h});try{const ah=req.headers.get('Authorization');if(!ah)throw Error('غير مصرح');const {data:{user},error:ae}=await s.auth.getUser(ah.replace('Bearer ',''));if(ae||!user)throw Error('جلسة غير صالحة');const b=await req.json();if(!b?.runsheet_code)throw Error('رقم الرانشيت مطلوب');const {data:st,error:se}=await s.from('app_settings').select('company_id').limit(1).maybeSingle();if(se||!st?.company_id)throw Error('سياق الشركة غير محدد');const {data,error}=await s.rpc('cancel_runsheet_loading',{p_company_id:st.company_id,p_runsheet_code:b.runsheet_code,p_user_email:user.email});if(error)throw Error(error.message);return new Response(JSON.stringify(data),{headers:{...h,'Content-Type':'application/json'}})}catch(e){return new Response(JSON.stringify({success:false,msg:e?.message||'فشل إلغاء التحميل'}),{status:400,headers:{...h,'Content-Type':'application/json'}})}})