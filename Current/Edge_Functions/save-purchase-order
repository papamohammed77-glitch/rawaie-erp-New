import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"
const supabase=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!)
serve(async(req)=>{
  const origin=req.headers.get('Origin')||'*'
  const headers={'Access-Control-Allow-Origin':origin,'Access-Control-Allow-Headers':'authorization, x-client-info, apikey, content-type','Access-Control-Allow-Methods':'POST, OPTIONS','Content-Type':'application/json'}
  if(req.method==='OPTIONS') return new Response('ok',{headers})
  try{
    const body=await req.json().catch(()=>({}))
    if(!body?.orderHeader||!Array.isArray(body?.itemsList)||!body.itemsList.length) throw new Error('البيانات غير مكتملة')
    const ah=req.headers.get('Authorization');if(!ah)throw new Error('غير مصرح')
    const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace('Bearer ',''))
    if(ae||!user?.id||!user?.email)throw new Error('جلسة غير صالحة')
    const {data:u,error:ue}=await supabase.from('users').select('company_id').eq('auth_id',user.id).maybeSingle()
    if(ue||!u?.company_id)throw new Error('سياق الشركة غير محدد للمستخدم')
    const items=body.itemsList.map((x:any)=>({code:String(x?.code??'').trim(),name:x?.name||'',unit:x?.unit||'حبة',price:Number(x?.price),qty:Number(x?.qty)}))
    const {data,error}=await supabase.rpc('save_purchase_order_atomic',{p_company_id:u.company_id,p_supplier_id:body.orderHeader.supplierId,p_supplier_name:body.orderHeader.supplierName||'',p_user_email:user.email,p_items:items})
    if(error)throw new Error(error.message)
    return new Response(JSON.stringify(data),{status:200,headers})
  }catch(e:any){return new Response(JSON.stringify({success:false,msg:e?.message||'فشل حفظ أمر الشراء'}),{status:400,headers})}
})