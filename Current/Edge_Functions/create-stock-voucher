// create-stock-voucher — company-scoped capability wrapper
import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"

const supabase=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!)
const corsHeaders={"Access-Control-Allow-Origin":"*","Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type","Access-Control-Allow-Methods":"POST, OPTIONS"}

serve(async(req)=>{
  if(req.method==='OPTIONS') return new Response('ok',{headers:corsHeaders})
  try{
    const body=await req.json().catch(()=>({}))
    const type=String(body?.type||'').trim()
    const items=Array.isArray(body?.items)?body.items:[]
    if(!type||!items.length) throw new Error('النوع والأصناف مطلوبة')
    const ah=req.headers.get('Authorization')
    if(!ah) throw new Error('غير مصرح')
    const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace('Bearer ',''))
    if(ae||!user?.id||!user?.email) throw new Error('جلسة غير صالحة')
    const {data:pu,error:ue}=await supabase.from('users').select('company_id').eq('auth_id',user.id).maybeSingle()
    if(ue||!pu?.company_id) throw new Error('سياق الشركة غير محدد للمستخدم')
    const companyId=pu.company_id
    const normalized=items.map((item:any)=>({itemCode:String(item?.itemCode??'').trim(),qty:Number(item?.qty),itemName:item?.itemName||item?.itemCode||'',unit:item?.unit||'حبة',unitPrice:Number(item?.unitPrice)||0,notes:item?.notes||''}))
    for(const x of normalized){if(!x.itemCode||!Number.isFinite(x.qty)||x.qty<=0) throw new Error('بيانات الصنف غير صالحة')}
    const {data,error}=await supabase.rpc('create_manual_stock_voucher_atomic',{p_company_id:companyId,p_type:type,p_reference:body?.reference||'',p_from_type:body?.fromType||'Branch',p_from_id:body?.fromId||null,p_to_type:body?.toType||'Branch',p_to_id:body?.toId||null,p_notes:body?.notes||'',p_created_by:user.email,p_items:normalized})
    if(error) throw new Error(error.message)
    return new Response(JSON.stringify(data),{headers:{...corsHeaders,'Content-Type':'application/json'}})
  }catch(e){return new Response(JSON.stringify({success:false,msg:e?.message||'فشل إنشاء الإذن'}),{status:400,headers:{...corsHeaders,'Content-Type':'application/json'}})}
})