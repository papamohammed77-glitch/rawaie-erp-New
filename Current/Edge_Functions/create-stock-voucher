// create-stock-voucher — company-scoped capability wrapper
import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"
const supabase=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!)
const corsHeaders={"Access-Control-Allow-Origin":"*","Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type","Access-Control-Allow-Methods":"POST, OPTIONS"}
serve(async(req)=>{if(req.method==='OPTIONS')return new Response('ok',{headers:corsHeaders});try{const body=await req.json().catch(()=>({}));const type=body?.type,items=body?.items;if(!type||!Array.isArray(items)||!items.length)throw new Error('النوع والأصناف مطلوبة');const ah=req.headers.get('Authorization');if(!ah)throw new Error('غير مصرح');const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace('Bearer ',''));if(ae||!user?.id||!user?.email)throw new Error('جلسة غير صالحة');const {data:pu,error:ue}=await supabase.from('users').select('id,company_id').eq('auth_id',user.id).maybeSingle();if(ue||!pu?.company_id)throw new Error('سياق الشركة غير محدد للمستخدم');const companyId=pu.company_id;const {data:lastVoucher,error:le}=await supabase.from('stock_vouchers').select('voucher_code').eq('company_id',companyId).order('voucher_code',{ascending:false}).limit(1).maybeSingle();if(le)throw new Error(le.message);let lastNum=0;const match=lastVoucher?.voucher_code?.match(/\d+/);if(match)lastNum=parseInt(match[0],10);const voucherCode=`IN-${lastNum+1}`;const fromId=body?.fromId||null,toId=body?.toId||null;for(const [id,label] of [[fromId,'المصدر'],[toId,'الوجهة']] as const){if(!id)continue;const {data:b,error:be}=await supabase.from('branches').select('id').eq('id',id).eq('company_id',companyId).limit(1);if(be||!b?.length)throw new Error(`فرع ${label} غير صالح`)}const normalized=[];for(const item of items){const code=String(item?.itemCode??'').trim(),qty=Number(item?.qty);if(!code||!Number.isFinite(qty)||qty<=0)throw new Error('بيانات الصنف غير صالحة');const {data:rows,error:ie}=await supabase.from('items').select('id,item_code,item_name').eq('company_id',companyId).eq('item_code',code).limit(2);if(ie)throw new Error(`فشل تحديد الصنف ${code}: ${ie.message}`);if(!rows?.length)throw new Error(`الصنف غير موجود ضمن الشركة ${companyId}: ${code}`);if(rows.length>1)throw new Error(`كود الصنف غير فريد داخل الشركة: ${code}`);const i=rows[0];normalized.push({item_id:i.id,item_code:i.item_code,item_name:item.itemName||i.item_name||i.item_code,unit:item.unit||'حبة',qty,unit_price:Number(item.unitPrice)||0,notes:item.notes||''})}const {data:v,error:ve}=await supabase.from('stock_vouchers').insert({voucher_code:voucherCode,voucher_date:new Date().toISOString().slice(0,10),type,status:'Draft',reference:body?.reference||'',from_type:body?.fromType||'Branch',from_id:fromId,to_type:body?.toType||'Branch',to_id:toId,notes:body?.notes||'',created_by:user.email,source:'Manual',company_id:companyId}).select('id').single();if(ve||!v)throw new Error(ve?.message||'فشل إنشاء الإذن');const {error:de}=await supabase.from('stock_voucher_details').insert(normalized.map(x=>({...x,voucher_id:v.id})));if(de)throw new Error(de.message);return new Response(JSON.stringify({success:true,voucherId:voucherCode,company_id:companyId}),{headers:{...corsHeaders,'Content-Type':'application/json'}})}catch(e){return new Response(JSON.stringify({success:false,msg:e?.message||'فشل إنشاء الإذن'}),{status:400,headers:{...corsHeaders,'Content-Type':'application/json'}})}})