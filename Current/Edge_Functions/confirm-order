import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
const supabase=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!);
serve(async(req)=>{const h={"Access-Control-Allow-Origin":req.headers.get("Origin")||"*","Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type","Access-Control-Allow-Methods":"POST, OPTIONS"};if(req.method==='OPTIONS')return new Response('ok',{headers:h});try{const b=await req.json().catch(()=>({}));const code=String(b?.order_code||'').trim();if(!code)throw new Error('رقم الأوردر مطلوب');const ah=req.headers.get('Authorization');if(!ah)throw new Error('غير مصرح');const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace(/^Bearer\s+/i,''));if(ae||!user?.id||!user.email)throw new Error('جلسة غير صالحة');const {data:u,error:ue}=await supabase.from('users').select('company_id,status').eq('auth_id',user.id).maybeSingle();if(ue||!u?.company_id)throw new Error('سياق الشركة غير محدد للمستخدم');if(u.status&&u.status!=='Active')throw new Error('المستخدم غير نشط');const c=u.company_id;const {data:o,error:oe}=await supabase.from('orders').select('id,order_code,order_status,runsheet_id').eq('company_id',c).eq('order_code',code).maybeSingle();if(oe||!o)throw new Error('الأوردر غير موجود');if(o.runsheet_id)throw new Error('لا يمكن تأكيد أوردر مرتبط برانشيت');if(o.order_status!=='Draft'&&o.order_status!=='Pending')throw new Error('لا يمكن تأكيد الأوردر في حالته الحالية: '+o.order_status);const {error:e}=await supabase.from('orders').update({order_status:'Confirmed'}).eq('company_id',c).eq('id',o.id).eq('order_status',o.order_status).is('runsheet_id',null);if(e)throw new Error('فشل تحديث حالة الأوردر: '+e.message);return new Response(JSON.stringify({success:true,msg:'تم تأكيد الأوردر'}),{headers:{...h,'Content-Type':'application/json'}})}catch(e){return new Response(JSON.stringify({success:false,msg:e?.message||'فشل تأكيد الأوردر'}),{status:400,headers:{...h,'Content-Type':'application/json'}})}});