import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase=createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const corsHeaders={
  "Access-Control-Allow-Origin":"*",
  "Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods":"POST, OPTIONS"
};

serve(async(req)=>{
  if(req.method==='OPTIONS') return new Response('ok',{headers:corsHeaders});
  try{
    const body=await req.json().catch(()=>({}));
    const orderCode=String(body?.order_code||'').trim();
    if(!orderCode) throw new Error('رقم الأوردر مطلوب');

    const authHeader=req.headers.get('Authorization');
    if(!authHeader) throw new Error('غير مصرح');
    const token=authHeader.replace(/^Bearer\s+/i,'');
    const {data:{user},error:authError}=await supabase.auth.getUser(token);
    if(authError||!user?.id||!user.email) throw new Error('جلسة غير صالحة');

    const {data:profile,error:profileError}=await supabase
      .from('users')
      .select('company_id,status')
      .eq('auth_id',user.id)
      .maybeSingle();
    if(profileError||!profile?.company_id) throw new Error('سياق الشركة غير محدد للمستخدم');
    if(profile.status&&profile.status!=='Active') throw new Error('المستخدم غير نشط');

    const {data,error}=await supabase.rpc('delete_order_atomic',{
      p_company_id:profile.company_id,
      p_order_code:orderCode,
      p_user_email:user.email
    });
    if(error) throw new Error(error.message);

    return new Response(JSON.stringify(data),{
      headers:{...corsHeaders,'Content-Type':'application/json'}
    });
  }catch(error){
    return new Response(JSON.stringify({
      success:false,
      msg:error?.message||'فشل حذف الأوردر'
    }),{
      status:400,
      headers:{...corsHeaders,'Content-Type':'application/json'}
    });
  }
});
