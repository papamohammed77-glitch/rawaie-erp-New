import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
const supabase=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!);
serve(async(req)=>{const h={"Access-Control-Allow-Origin":req.headers.get("Origin")||"*","Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type","Access-Control-Allow-Methods":"POST, OPTIONS"};if(req.method==='OPTIONS')return new Response('ok',{headers:h});try{const b=await req.json().catch(()=>({}));const code=String(b?.order_code||'').trim();if(!code)throw new Error('رقم الأوردر مطلوب');const ah=req.headers.get('Authorization');if(!ah)throw new Error('غير مصرح');const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace(/^Bearer\s+/i,''));if(ae||!user?.id||!user.email)throw new Error('جلسة غير صالحة');const {data:u,error:ue}=await supabase.from('users').select('company_id,status').eq('auth_id',user.id).maybeSingle();if(ue||!u?.company_id)throw new Error('سياق الشركة غير محدد للمستخدم');if(u.status&&u.status!=='Active')throw new Error('المستخدم غير نشط');const c=u.company_id;const {data:o,error:oe}=await supabase.from('orders').select('id,order_code,order_status,runsheet_id,company_id').eq('company_id',c).eq('order_code',code).maybeSingle();if(oe||!o)throw new Error('الأوردر غير موجود');if(o.runsheet_id)throw new Error('لا يمكن حذف أوردر مربوط برانشيت');if(['Draft','Confirmed','Pending'].indexOf(o.order_status)===-1)throw new Error('لا يمكن حذف الأوردر في حالته الحالية؛ الفواتير المنفذة تعالج عبر مسار عكسي رسمي');const {error:de}=await supabase.from('order_details').delete().eq('order_id',o.id);if(de)throw new Error('فشل حذف تفاصيل الأوردر: '+de.message);const {data:deleted,error:oe2}=await supabase.from('orders').delete().eq('company_id',c).eq('id',o.id).select('id').maybeSingle();if(oe2)throw new Error('فشل حذف الأوردر: '+oe2.message);if(!deleted)throw new Error('لم يتم حذف الأوردر');await supabase.from('audit_log').insert({user_email:user.email,action:'hard_delete_order',table_name:'orders',record_id:code,old_data:o,new_data:{deleted_order_code:code,deleted_by:user.email}});return new Response(JSON.stringify({success:true,msg:'تم حذف الأوردر نهائياً بنجاح'}),{headers:{...h,'Content-Type':'application/json'}})}catch(e){return new Response(JSON.stringify({success:false,msg:e?.message||'فشل حذف الأوردر'}),{status:400,headers:{...h,'Content-Type':'application/json'}})}});