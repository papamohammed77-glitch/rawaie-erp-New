// complete-return – authoritative Production v24
// Contract: authentication -> auth-linked company -> complete_return_atomic.
// Physical stock mutation is delegated exclusively to post_stock_movement.

import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
)

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS"
}

serve(async (req) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders })

  try {
    const body = await req.json().catch(() => ({}))
    const runsheet_code = body?.runsheet_code ?? null
    const order_code = body?.order_code ?? null
    const items = body?.items
    const is_pos_return = body?.is_pos_return === true

    if ((!runsheet_code && !order_code) || !Array.isArray(items) || !items.length) {
      throw new Error("البيانات غير مكتملة")
    }

    const authHeader = req.headers.get("Authorization")
    if (!authHeader) throw new Error("غير مصرح")
    const { data: { user }, error: authError } = await supabase.auth.getUser(authHeader.replace("Bearer ", ""))
    if (authError || !user?.id || !user.email) throw new Error("جلسة غير صالحة")

    const { data: appUser, error: userError } = await supabase
      .from("users")
      .select("company_id,status")
      .eq("auth_id", user.id)
      .maybeSingle()

    if (userError || !appUser?.company_id || (appUser.status && appUser.status !== "Active")) {
      throw new Error("سياق الشركة غير متاح للمستخدم المصادق عليه")
    }

    const { data, error } = await supabase.rpc("complete_return_atomic", {
      p_company_id: appUser.company_id,
      p_runsheet_code: runsheet_code,
      p_order_code: order_code,
      p_is_pos_return: is_pos_return,
      p_user_email: user.email,
      p_items: items
    })

    if (error) throw new Error(error.message)

    return new Response(JSON.stringify(data), {
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    })
  } catch (e) {
    return new Response(JSON.stringify({
      success: false,
      msg: e?.message || "فشل إنهاء المرتجعات"
    }), {
      status: 400,
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    })
  }
})
