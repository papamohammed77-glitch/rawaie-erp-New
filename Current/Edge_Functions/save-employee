import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const db = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const cors = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS"
};

function asBool(value) {
  return value === true || String(value ?? "").toLowerCase() === "true";
}

function normalizeBranches(value) {
  if (value === null || value === undefined || value === "") return ["*"];
  if (Array.isArray(value)) {
    const out = value.map(x => String(x).trim()).filter(Boolean);
    return out.length ? out : ["*"];
  }
  const s = String(value).trim();
  if (s === "*") return ["*"];
  try {
    const parsed = JSON.parse(s);
    if (Array.isArray(parsed)) {
      const out = parsed.map(x => String(x).trim()).filter(Boolean);
      return out.length ? out : ["*"];
    }
  } catch (_) {}
  const out = s.split(",").map(x => x.trim()).filter(Boolean);
  return out.length ? out : ["*"];
}

function normalizePermissions(value) {
  if (Array.isArray(value)) {
    return Array.from(new Set(value.map(x => String(x).trim()).filter(Boolean)));
  }
  if (typeof value === "string" && value.trim()) {
    try {
      const parsed = JSON.parse(value);
      if (Array.isArray(parsed)) return normalizePermissions(parsed);
    } catch (_) {}
    return Array.from(new Set(value.split(",").map(x => x.trim()).filter(Boolean)));
  }
  return [];
}

async function getActor(req) {
  const h = req.headers.get("Authorization");
  if (!h) throw new Error("غير مصرح");
  const { data: { user }, error } =
    await db.auth.getUser(h.replace("Bearer ", ""));
  if (error || !user?.id) throw new Error("جلسة غير صالحة");

  const { data: actor, error: ue } = await db
    .from("users")
    .select("id,company_id,status,permissions,auth_id")
    .eq("auth_id", user.id)
    .maybeSingle();

  if (ue || !actor || actor.status === "Inactive" || !actor.company_id) {
    throw new Error("سياق المستخدم غير صالح");
  }

  const permissions = normalizePermissions(actor.permissions);

  const { data: ownerProfile, error: oe } = await db
    .from("owner_profile")
    .select("auth_user_id")
    .eq("auth_user_id", user.id)
    .maybeSingle();

  if (oe) throw oe;

  const isOwner =
    asBool(user.user_metadata?.isOwner) &&
    permissions.includes("*") &&
    !!ownerProfile;

  if (!isOwner && !permissions.includes("users")) {
    throw new Error("لا تملك صلاحية إدارة المستخدمين");
  }

  return { user, actor, companyId: actor.company_id, isOwner };
}

async function targetIsOwner(authId) {
  if (!authId) return false;

  const { data: targetAuth, error: ae } =
    await db.auth.admin.getUserById(authId);
  if (ae) throw ae;

  const { data: profile, error: pe } = await db
    .from("owner_profile")
    .select("auth_user_id")
    .eq("auth_user_id", authId)
    .maybeSingle();

  if (pe) throw pe;

  return asBool(targetAuth?.user?.user_metadata?.isOwner) && !!profile;
}

async function writeAudit(userEmail, action, recordId, oldData, newData) {
  const { error } = await db.from("audit_log").insert({
    user_email: userEmail || "system",
    action,
    table_name: "users",
    record_id: String(recordId),
    old_data: oldData ?? null,
    new_data: newData ?? null
  });
  if (error) throw error;
}

async function getRole(companyId, roleName) {
  const normalizedName = String(roleName || "").trim();
  if (!normalizedName) throw new Error("الدور الوظيفي مطلوب");

  const { data: role, error } = await db
    .from("roles")
    .select("id,role_name,permissions")
    .eq("company_id", companyId)
    .eq("role_name", normalizedName)
    .maybeSingle();

  if (error) throw error;
  if (!role) throw new Error("الدور الوظيفي غير موجود ضمن الشركة الحالية");

  return {
    id: role.id,
    roleName: role.role_name,
    permissions: normalizePermissions(role.permissions)
  };
}

async function getAuthSnapshot(authId) {
  if (!authId) return null;
  const { data, error } = await db.auth.admin.getUserById(authId);
  if (error) throw error;
  return {
    id: data.user.id,
    email: data.user.email || null,
    user_metadata: { ...(data.user.user_metadata || {}) }
  };
}

async function restoreAuthSnapshot(snapshot) {
  if (!snapshot?.id) return;
  const attrs = {
    user_metadata: snapshot.user_metadata
  };
  if (snapshot.email) {
    attrs.email = snapshot.email;
    attrs.email_confirm = true;
  }
  const { error } = await db.auth.admin.updateUserById(snapshot.id, attrs);
  if (error) console.error("USER_AUTH_ROLLBACK_FAILED", error);
}

serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: cors });
  }

  try {
    const body = await req.json().catch(() => ({}));
    const employee = body?.employee || {};
    const isEdit = body?.isEdit === true;
    const originalEmail = String(body?.originalEmail || "").trim();

    const employeeName = String(employee.name || "").trim();
    const employeeEmail = String(employee.email || "").trim();
    if (!employeeName || !employeeEmail) {
      throw new Error("الاسم والبريد مطلوبان");
    }

    const { user, companyId, isOwner } = await getActor(req);

    if (!isEdit && !String(employee.password || "")) {
      throw new Error("كلمة المرور مطلوبة عند إنشاء مستخدم جديد");
    }

    const role = await getRole(companyId, employee.role);

    const requestedPermissions = normalizePermissions(employee.permissions);

    if (requestedPermissions.includes("*") && !isOwner) {
      throw new Error("صلاحية wildcard (*) محجوزة للمالك");
    }

    if (role.permissions.includes("*") && !isOwner) {
      throw new Error("الدور المحدد يحتوي wildcard (*) ولا يمكن استخدامه من غير المالك");
    }

    const merged = Array.from(new Set([
      ...role.permissions,
      ...requestedPermissions
    ]));

    const allowed = normalizeBranches(employee.allowed_branch_ids);
    const scoped = allowed.filter(x => x !== "*");

    if (scoped.length) {
      const { data: branches, error: be } = await db
        .from("branches")
        .select("branch_code")
        .eq("company_id", companyId)
        .in("branch_code", scoped);

      if (be) throw be;
      if ((branches || []).length !== scoped.length) {
        throw new Error("يوجد فرع غير تابع للشركة الحالية");
      }
    }

    const empData = {
      name: employeeName,
      email: employeeEmail,
      phone: employee.phone || null,
      role: role.roleName,
      role_id: role.id,
      status: employee.status || "Active",
      expiry_date: employee.expiry_date || null,
      allowed_branch_ids: allowed,
      permissions: merged,
      allow_all_customers: !!employee.allow_all_customers,
      restrict_to_visit_day: employee.restrict_to_visit_day !== false,
      device_id: employee.device_id || null,
      company_id: companyId,
      password_hash: "managed_by_supabase_auth"
    };

    if (isEdit && originalEmail) {
      const { data: existing, error: ee } = await db
        .from("users")
        .select("*")
        .eq("company_id", companyId)
        .eq("email", originalEmail)
        .maybeSingle();

      if (ee) throw ee;
      if (!existing) throw new Error("المستخدم غير موجود");

      if (await targetIsOwner(existing.auth_id)) {
        throw new Error("لا يمكن تعديل حساب المالك من هذه الشاشة");
      }

      const oldData = { ...existing };
      const authSnapshot = await getAuthSnapshot(existing.auth_id);

      const { error: de } = await db
        .from("users")
        .update(empData)
        .eq("id", existing.id)
        .eq("company_id", companyId);

      if (de) throw de;

      try {
        if (existing.auth_id) {
          const authAttrs = {
            user_metadata: {
              ...(authSnapshot?.user_metadata || {}),
              name: empData.name,
              role: empData.role,
              isOwner: false,
              permissions: merged
            }
          };

          if (
            empData.email.toLowerCase() !==
            String(existing.email || "").toLowerCase()
          ) {
            authAttrs.email = empData.email;
            authAttrs.email_confirm = true;
          }

          if (employee.password) {
            authAttrs.password = String(employee.password);
          }

          authAttrs.ban_duration =
            empData.status === "Inactive" ? "876000h" : "none";

          const { error: authUpdateError } =
            await db.auth.admin.updateUserById(existing.auth_id, authAttrs);

          if (authUpdateError) throw authUpdateError;
        }

        await writeAudit(
          user.email,
          "update",
          existing.id,
          oldData,
          { ...empData, auth_id: existing.auth_id || null }
        );
      } catch (operationError) {
        await db.from("users")
          .update(oldData)
          .eq("id", existing.id)
          .eq("company_id", companyId);

        await restoreAuthSnapshot(authSnapshot);
        throw operationError;
      }

      return new Response(JSON.stringify({
        success: true,
        action: "updated",
        user_id: existing.id
      }), {
        headers: { ...cors, "Content-Type": "application/json" }
      });
    }

    const { data: newAuth, error: ae } =
      await db.auth.admin.createUser({
        email: empData.email,
        password: String(employee.password),
        email_confirm: true,
        user_metadata: {
          name: empData.name,
          role: empData.role,
          isOwner: false,
          permissions: merged
        }
      });

    if (ae || !newAuth?.user) {
      throw ae || new Error("فشل إنشاء حساب المصادقة");
    }

    const insertPayload = {
      ...empData,
      auth_id: newAuth.user.id
    };

    let created = null;

    try {
      const { data: inserted, error: ie } = await db
        .from("users")
        .insert(insertPayload)
        .select("id")
        .single();

      if (ie || !inserted) {
        throw ie || new Error("فشل إنشاء سجل المستخدم");
      }

      created = inserted;

      await writeAudit(
        user.email,
        "create",
        created.id,
        null,
        insertPayload
      );
    } catch (operationError) {
      if (created?.id) {
        await db.from("users").delete().eq("id", created.id).eq("company_id", companyId);
      }
      await db.auth.admin.deleteUser(newAuth.user.id).catch(() => {});
      throw operationError;
    }

    return new Response(JSON.stringify({
      success: true,
      action: "created",
      user_id: created.id
    }), {
      headers: { ...cors, "Content-Type": "application/json" }
    });
  } catch (e) {
    console.error("save-employee", e);
    return new Response(JSON.stringify({
      success: false,
      error: e?.message || "فشل الحفظ"
    }), {
      status: 400,
      headers: { ...cors, "Content-Type": "application/json" }
    });
  }
});