import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
const db=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!);
const cors={"Access-Control-Allow-Origin":"*","Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type","Access-Control-Allow-Methods":"POST, OPTIONS"};
async function actor(req){const h=req.headers.get("Authorization");if(!h)throw Error("غير مصرح");const {data:{user},error}=await db.auth.getUser(h.replace("Bearer ",""));if(error||!user)throw Error("جلسة غير صالحة");const {data:u,error:ue}=await db.from("users").select("id,company_id,status").eq("auth_id",user.id).maybeSingle();if(ue||!u||u.status==='Inactive')throw Error("سياق الشركة غير صالح");return {user,companyId:u.company_id};}
serve(async req=>{if(req.method==='OPTIONS')return new Response('ok',{headers:cors});try{const {employee,isEdit,originalEmail}=await req.json();if(!employee?.name||!employee?.email)throw Error('الاسم والبريد مطلوبان');const {companyId}=await actor(req);let rolePermissions=[];if(employee.role){const {data:r,error}=await db.from('roles').select('permissions').eq('company_id',companyId).eq('role_name',employee.role).maybeSingle();if(error)throw error;if(r?.permissions)rolePermissions=r.permissions;}const merged=[...rolePermissions];for(const p of(employee.permissions||[]))if(!merged.includes(p))merged.push(p);const allowed=String(employee.allowed_branch_ids||'').split(',').map(x=>x.trim()).filter(Boolean);if(allowed.length){const {data:br,error}=await db.from('branches').select('branch_code').eq('company_id',companyId).in('branch_code',allowed);if(error)throw error;if((br||[]).length!==allowed.length)throw Error('يوجد فرع غير تابع للشركة الحالية');}const empData={name:employee.name,email:employee.email,phone:employee.phone||null,role:employee.role||'موظف',status:employee.status||'Active',expiry_date:employee.expiry_date||null,allowed_branch_ids:employee.allowed_branch_ids||'*',permissions:merged,allow_all_customers:!!employee.allow_all_customers,restrict_to_visit_day:employee.restrict_to_visit_day!==false,device_id:employee.device_id||null,company_id:companyId,password_hash:'managed_by_supabase_auth'};if(isEdit&&originalEmail){const {error}=await db.from('users').update(empData).eq('company_id',companyId).eq('email',originalEmail);if(error)throw error;if(employee.password){const {data:list}=await db.auth.admin.listUsers();const target=(list?.users||[]).find(x=>x.email?.toLowerCase()===String(originalEmail).toLowerCase());if(target){const {error:pe}=await db.auth.admin.updateUserById(target.id,{password:employee.password,user_metadata:{name:employee.name,role:employee.role||'موظف',isOwner:false,permissions:merged}});if(pe)throw pe;}}return new Response(JSON.stringify({success:true,action:'updated'}),{headers:{...cors,'Content-Type':'application/json'}});}const {data:newAuth,error:ae}=await db.auth.admin.createUser({email:employee.email,password:employee.password||'123456',email_confirm:true,user_metadata:{name:employee.name,role:employee.role||'موظف',isOwner:false,permissions:merged}});if(ae||!newAuth?.user)throw ae||Error('فشل إنشاء حساب المصادقة');const {error:ie}=await db.from('users').insert({...empData,auth_id:newAuth.user.id});if(ie){await db.auth.admin.deleteUser(newAuth.user.id).catch(()=>{});throw ie;}return new Response(JSON.stringify({success:true,action:'created'}),{headers:{...cors,'Content-Type':'application/json'}});}catch(e){return new Response(JSON.stringify({success:false,error:e?.message||'فشل الحفظ'}),{status:400,headers:{...cors,'Content-Type':'application/json'}})}});