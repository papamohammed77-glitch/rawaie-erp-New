const corsHeaders={"Access-Control-Allow-Origin":"*","Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type","Access-Control-Allow-Methods":"POST, OPTIONS"}
serve(async(req)=>{if(req.method==="OPTIONS")return new Response("ok",{headers:corsHeaders});try{const rawBody=await req.text();if(!rawBody)throw new Error("Body فارغ");let body:any;try{body=JSON.parse(rawBody)}catch{throw new Error("صيغة JSON غير صالحة")};const runsheet_code=body?.runsheet_code;const items=body?.items;if(!runsheet_code||!Array.isArray(items)||!items.length)throw new Error("البيانات غير مكتملة");const ah=req.headers.get("Authorization");if(!ah)throw new Error("غير مصرح");const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace("Bearer ",""));if(ae||!user)throw new Error("جلسة غير صالحة");const {data:settings,error:se}=await supabase.from("app_settings").select("company_id,main_branch_id").limit(1).maybeSingle();if(se||!settings?.company_id||!settings?.main_branch_id)throw new Error("سياق الشركة/الفرع الرئيسي غير محدد");const itemCodes=items.map((x:any)=>x?.itemCode??x?.item_code).filter(Boolean);const {data:itemRows,error:ie}=await supabase.from("items").select("id,item_code").eq("company_id",settings.company_id).in("item_code",itemCodes);if(ie)throw new Error(ie.message);const itemMap:any={};for(const row of itemRows||[])itemMap[row.item_code]=row.id;const {data:rs,error:re}=await supabase.from("runsheets").select("id,status").eq("company_id",settings.company_id).eq("runsheet_code",runsheet_code).maybeSingle();if(re||!rs)throw new Error("الرانشيت غير موجود");if(rs.status!=="Picking")throw new Error("الرانشيت ليس قيد التحضير");const {data:lock,error:le}=await supabase.from("runsheets").update({status:"PickingProcessing"}).eq("id",rs.id).eq("status","Picking").select();if(le)throw new Error(le.message);if(!lock?.length)throw new Error("تمت معالجة الرانشيت بواسطة مستخدم آخر");for(const item of items){const pickedQty=Number(item?.pickedQty)||0;if(pickedQty<=0)continue;const itemId=itemMap[item?.itemCode];if(!itemId)throw new Error("الصنف غير موجود: "+item?.itemCode);const {data:reserved,error:stockError}=await supabase.rpc("reserve_stock",{p_company_id:settings.company_id,p_branch_id:settings.main_branch_id,p_item_id:itemId,p_qty:pickedQty});if(stockError||reserved!==true)throw new Error("فشل حجز المخزون لـ "+item?.itemCode+": "+(stockError?.message||"reserve_stock لم تؤكد نجاح العملية"));const {error:logError}=await supabase.from("inventory_log").insert({company_id:settings.company_id,log_code:"PCK-"+crypto.randomUUID(),movement_date:new Date().toISOString().split("T")[0],voucher_id:runsheet_code,item_id:itemId,item_code:item?.itemCode,item_name:item?.itemName??"",movement_type:"Picking",qty:pickedQty,reference:runsheet_code,user_email:user.email});if(logError)throw new Error("فشل تسجيل حركة المخزون: "+logError.message);const {data:orders,error:oe}=await supabase.from("orders").select("id").eq("company_id",settings.company_id).eq("runsheet_id",rs.id);if(oe)throw new Error(oe.message);const orderIds=(orders||[]).map((o:any)=>o.id);if(orderIds.length){const {data:ods,error:ode}=await supabase.from("order_details").select("id,qty").in("order_id",orderIds).eq("item_code",item?.itemCode);if(ode)throw new Error(ode.message);for(const od of ods||[]){const reason=pickedQty<Number(od.qty||0)?(item?.notes||"نقص في التحضير"):null;const {error:ude}=await supabase.from("order_details").update({qty_picked:pickedQty,reason_picking:reason}).eq("id",od.id);if(ude)throw new Error(ude.message)}}}const {error:finishError}=await supabase.from("runsheets").update({status:"Picked",picker_end:new Date().toISOString(),updated_at:new Date().toISOString()}).eq("id",rs.id).eq("status","PickingProcessing");if(finishError)throw new Error(finishError.message);return new Response(JSON.stringify({success:true,msg:"تم إنهاء التحضير"}),{headers:{...corsHeaders,"Content-Type":"application/json"}})}catch(error:any){return new Response(JSON.stringify({success:false,msg:error?.message||"فشل إنهاء التحضير"}),{status:400,headers:{...corsHeaders,"Content-Type":"application/json"}})}})