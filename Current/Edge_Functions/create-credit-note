import "jsr:@supabase/functions-js/edge-runtime.d.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
)

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS"
}

Deno.serve(async (req: Request) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders })

  try {
    const body = await req.json().catch(() => ({}))
    const runsheet_code = body?.runsheet_code ? String(body.runsheet_code).trim() : null
    const order_code = body?.order_code ? String(body.order_code).trim() : null
    const items = Array.isArray(body?.items) ? body.items : []
    const reason = String(body?.reason || "مرتجع بضاعة").trim()
    const is_pos_return = body?.is_pos_return === true

    if ((!runsheet_code && !order_code) || !items.length) {
      throw new Error("البيانات غير مكتملة")
    }

    const authHeader = req.headers.get("Authorization")
    if (!authHeader) throw new Error("غير مصرح")
    const token = authHeader.replace(/^Bearer\s+/i, "")
    const { data: { user }, error: authError } = await supabase.auth.getUser(token)
    if (authError || !user?.id || !user.email) throw new Error("جلسة غير صالحة")

    const { data: actor, error: actorError } = await supabase
      .from("users")
      .select("company_id,status")
      .eq("auth_id", user.id)
      .maybeSingle()

    if (actorError || !actor?.company_id) throw new Error("سياق الشركة غير محدد للمستخدم")
    if (actor.status && actor.status !== "Active") throw new Error("المستخدم غير نشط")

    const { data, error } = await supabase.rpc("complete_sales_return_credit_note_atomic", {
      p_company_id: actor.company_id,
      p_runsheet_code: runsheet_code,
      p_order_code: order_code,
      p_is_pos_return: is_pos_return,
      p_user_email: user.email,
      p_items: items,
      p_reason: reason
    })

    if (error) throw new Error(error.message)

    return new Response(JSON.stringify(data), {
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    })
  } catch (error) {
    return new Response(JSON.stringify({
      success: false,
      msg: error?.message || "فشل إنشاء المرتجع والإشعار الدائن"
    }), {
      status: 400,
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    })
  }
})
