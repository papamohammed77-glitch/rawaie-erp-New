import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"
const supabase=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!)
serve(async(req)=>{
  const origin=req.headers.get('Origin')||'*'
  const headers={'Access-Control-Allow-Origin':origin,'Access-Control-Allow-Headers':'authorization, x-client-info, apikey, content-type','Access-Control-Allow-Methods':'POST, OPTIONS','Content-Type':'application/json'}
  if(req.method==='OPTIONS')return new Response('ok',{headers})
  try{
    const body=await req.json().catch(()=>({})),u=body?.user,items=Array.isArray(body?.cartItems)?body.cartItems:[]
    if(!u?.name||!u?.phone||!u?.area)throw new Error('بيانات العميل غير مكتملة')
    if(!items.length)throw new Error('السلة فارغة')
    const ah=req.headers.get('Authorization');if(!ah)throw new Error('غير مصرح')
    const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace('Bearer ',''))
    if(ae||!user?.id||!user?.email)throw new Error('جلسة غير صالحة')
    const {data:row,error:ue}=await supabase.from('users').select('company_id').eq('auth_id',user.id).maybeSingle()
    if(ue||!row?.company_id)throw new Error('سياق الشركة غير محدد للمستخدم')
    const cart=items.map((x:any)=>({code:String(x?.code??'').trim(),name:x?.name||'',qty:Number(x?.qty),price:Number(x?.price||0),unit:x?.unit||'حبة'}))
    const {data,error}=await supabase.rpc('submit_online_order_atomic',{p_company_id:row.company_id,p_customer_name:String(u.name).trim(),p_customer_phone:String(u.phone).trim(),p_customer_area:String(u.area).trim(),p_notes:u.notes||'',p_user_email:user.email,p_cart_items:cart})
    if(error)throw new Error(error.message)
    return new Response(JSON.stringify(data),{status:200,headers})
  }catch(e:any){return new Response(JSON.stringify({success:false,msg:e?.message||e?.error||'فشل إرسال الطلب'}),{status:400,headers})}
})