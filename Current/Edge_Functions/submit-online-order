import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type, idempotency-key, x-storefront-key",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
  "Content-Type": "application/json",
  "Vary": "Origin"
};

function json(body: unknown, status = 200) {
  return new Response(JSON.stringify(body), { status, headers: corsHeaders });
}

serve(async (req: Request) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
  if (req.method !== "POST") return json({ success: false, msg: "طريقة الطلب غير مدعومة" }, 405);

  try {
    const body = await req.json().catch(() => ({} as Record<string, unknown>)) as Record<string, any>;
    const customer = body?.user;
    const rawItems = Array.isArray(body?.cartItems) ? body.cartItems : [];
    const storefrontKey = String(body?.storefront_key || req.headers.get("x-storefront-key") || "").trim();
    const authorization = req.headers.get("Authorization") || "";
    const bearer = authorization.replace(/^Bearer\s+/i, "").trim();
    const apiKey = String(req.headers.get("apikey") || "").trim();

    const customerName = String(customer?.name || "").trim();
    const customerPhone = String(customer?.phone || "").trim();
    const customerArea = String(customer?.area || "").trim();
    const notes = String(customer?.notes || "").trim();

    if (!customerName || !customerPhone || !customerArea) throw new Error("بيانات العميل غير مكتملة");
    if (!rawItems.length) throw new Error("السلة فارغة");
    if (rawItems.length > 100) throw new Error("عدد أصناف الطلب يتجاوز الحد المسموح");

    let companyId: string | null = null;
    let actorEmail = "online-store";
    let authenticatedCompanyId: string | null = null;

    // Preserve the parent-system consumer: a real user JWT remains company-scoped.
    // The standalone public store sends the public API key as both apikey and Bearer.
    if (bearer && !(apiKey && bearer === apiKey)) {
      const { data: authData, error: authError } = await supabase.auth.getUser(bearer);
      if (authData?.user?.id && authData.user.email && !authError) {
        const { data: profile, error: profileError } = await supabase
          .from("users")
          .select("company_id,status,email")
          .eq("auth_id", authData.user.id)
          .maybeSingle();
        if (profileError || !profile?.company_id || (profile.status && profile.status !== "Active")) {
          throw new Error("سياق الشركة غير متاح للمستخدم المصادق عليه");
        }
        authenticatedCompanyId = profile.company_id;
        companyId = profile.company_id;
        actorEmail = authData.user.email;

        if (storefrontKey) {
          const { data: mappedStore, error: mapError } = await supabase
            .from("app_settings")
            .select("company_id")
            .eq("storefront_key", storefrontKey)
            .eq("storefront_enabled", true)
            .maybeSingle();
          if (mapError || !mappedStore || mappedStore.company_id !== authenticatedCompanyId) {
            throw new Error("مفتاح المتجر لا يتبع شركة المستخدم المصادق عليه");
          }
        }
      } else if (!storefrontKey) {
        throw new Error("جلسة غير صالحة؛ أعد تسجيل الدخول أو استخدم متجرًا منشورًا");
      }
    }

    // Public guest checkout is restricted to an explicitly published storefront.
    if (!companyId) {
      let storeQuery = supabase
        .from("app_settings")
        .select("company_id,storefront_key,storefront_enabled")
        .eq("storefront_enabled", true);
      if (storefrontKey) storeQuery = storeQuery.eq("storefront_key", storefrontKey);
      const { data: stores, error: storeError } = await storeQuery.limit(2);
      if (storeError) throw new Error("تعذر التحقق من المتجر المنشور");
      if (!stores || stores.length === 0) throw new Error("المتجر غير منشور أو مفتاح المتجر غير صالح");
      if (stores.length !== 1) throw new Error("storefront_key مطلوب عند وجود أكثر من متجر منشور");
      companyId = stores[0].company_id;
    }

    const operationId = String(body?.operation_id || req.headers.get("idempotency-key") || "").trim() || crypto.randomUUID();
    const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
    if (!uuidPattern.test(operationId)) throw new Error("operation_id يجب أن يكون UUID صالحًا");

    const cart = rawItems.map((item: any) => ({
      code: String(item?.code ?? "").trim(),
      name: String(item?.name ?? "").trim(),
      qty: Number(item?.qty),
      price: Number(item?.price ?? 0),
      unit: String(item?.unit || "حبة").trim()
    }));
    if (cart.some((item: any) => !item.code || !Number.isFinite(item.qty) || item.qty <= 0)) {
      throw new Error("توجد كمية أو بيانات صنف غير صالحة");
    }

    const { data, error } = await supabase.rpc("submit_online_order_atomic", {
      p_company_id: companyId,
      p_customer_name: customerName,
      p_customer_phone: customerPhone,
      p_customer_area: customerArea,
      p_notes: notes,
      p_user_email: actorEmail,
      p_cart_items: cart,
      p_operation_id: operationId
    });
    if (error) throw new Error(error.message);
    if (!data || data.success !== true) throw new Error(data?.msg || "تعذر إنشاء الطلب");
    return json(data, 200);
  } catch (error) {
    const message = error instanceof Error ? error.message : "فشل إرسال الطلب";
    return json({ success: false, msg: message }, 400);
  }
});
