import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
const supabase=createClient(Deno.env.get("SUPABASE_URL")!,Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!);
serve(async(req)=>{const origin=req.headers.get("Origin")||"*";const h={"Access-Control-Allow-Origin":origin,"Access-Control-Allow-Headers":"authorization, x-client-info, apikey, content-type","Access-Control-Allow-Methods":"POST, OPTIONS"};if(req.method==='OPTIONS')return new Response('ok',{headers:h});try{const b=await req.json().catch(()=>({}));const target=String(b?.targetRSID||'').trim();const selected=[...new Set((Array.isArray(b?.selectedOrders)?b.selectedOrders:[]).map(x=>String(x).trim()).filter(Boolean))];if(!target||!selected.length)throw new Error('البيانات غير مكتملة');const ah=req.headers.get('Authorization');if(!ah)throw new Error('غير مصرح');const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace(/^Bearer\s+/i,''));if(ae||!user?.id||!user.email)throw new Error('جلسة غير صالحة');const {data:u,error:ue}=await supabase.from('users').select('id,company_id,email,status').eq('auth_id',user.id).maybeSingle();if(ue)throw new Error(ue.message);if(!u?.company_id)throw new Error('سياق الشركة غير محدد للمستخدم');if(u.status&&u.status!=='Active')throw new Error('المستخدم غير نشط');const c=u.company_id;const {data:rs,error:re}=await supabase.from('runsheets').select('id,runsheet_code,status,company_id').eq('company_id',c).eq('runsheet_code',target).maybeSingle();if(re||!rs)throw new Error('الرانشيت غير موجود');if(!['Open','Confirmed'].includes(rs.status))throw new Error('الرانشيت غير مفتوح للإضافة');const {data:orders,error:oe}=await supabase.from('orders').select('id,order_code,total_amount,runsheet_id,order_status,company_id').eq('company_id',c).in('order_code',selected);if(oe)throw new Error(oe.message);if(!orders||orders.length!==selected.length)throw new Error('أحد الأوردرات المحددة غير موجود في سياق الشركة');for(const o of orders){if(o.runsheet_id)throw new Error(`الأوردر ${o.order_code} مرتبط برانشيت آخر`);if(!['Confirmed','Pending'].includes(o.order_status))throw new Error(`لا يمكن ضم الأوردر ${o.order_code} في حالته الحالية`)}const ids=orders.map(o=>o.id);const {data:details,error:de}=await supabase.from('order_details').select('item_id,item_code,item_name,unit,unit_price,qty').in('order_id',ids);if(de)throw new Error(de.message);const itemMap={};for(const d of(details||[])){if(!d.item_id||!d.item_code)throw new Error(`هوية صنف غير صالحة في ${d.item_code||'سطر'}`);if(!itemMap[d.item_code])itemMap[d.item_code]={item_id:d.item_id,item_code:d.item_code,item_name:d.item_name,unit:d.unit||'حبة',unit_price:d.unit_price,qty_ordered:0};itemMap[d.item_code].qty_ordered+=Number(d.qty)||0}const codes=Object.keys(itemMap);const {data:master,error:me}=await supabase.from('items').select('id,item_code').in('item_code',codes);if(me)throw new Error(me.message);const masterMap={};for(const i of(master||[]))masterMap[i.item_code]=i.id;for(const code of codes)if(masterMap[code]!==itemMap[code].item_id)throw new Error(`هوية الصنف لا تطابق Global Item Master: ${code}`);const {data:existing,error:xe}=await supabase.from('run_sheet_details').select('id,item_id,item_code,qty_ordered').eq('runsheet_id',rs.id);if(xe)throw new Error(xe.message);const exMap={};for(const x of(existing||[]))exMap[x.item_code]=x;for(const code of codes){const n=itemMap[code];const ex=exMap[code];if(ex){const {error:e}=await supabase.from('run_sheet_details').update({qty_ordered:(Number(ex.qty_ordered)||0)+n.qty_ordered}).eq('id',ex.id).eq('runsheet_id',rs.id);if(e)throw new Error(e.message)}else{const {error:e}=await supabase.from('run_sheet_details').insert({runsheet_id:rs.id,item_id:n.item_id,item_code:n.item_code,item_name:n.item_name,unit:n.unit,unit_price:n.unit_price,qty_ordered:n.qty_ordered});if(e)throw new Error(e.message)}}const additional=orders.reduce((s,o)=>s+(Number(o.total_amount)||0),0);for(const o of orders){const {error:e}=await supabase.from('orders').update({runsheet_id:rs.id,order_status:'Pending'}).eq('company_id',c).eq('id',o.id).is('runsheet_id',null);if(e)throw new Error(e.message)}const {data:curr,error:ce}=await supabase.from('runsheets').select('total_amount').eq('company_id',c).eq('id',rs.id).single();if(ce)throw new Error(ce.message);const {error:re2}=await supabase.from('runsheets').update({total_amount:(Number(curr?.total_amount)||0)+additional}).eq('company_id',c).eq('id',rs.id);if(re2)throw new Error(re2.message);return new Response(JSON.stringify({success:true,rsId:target}),{headers:{...h,'Content-Type':'application/json'}})}catch(e){return new Response(JSON.stringify({success:false,msg:e?.message||'فشل ضم الأوردرات'}),{status:400,headers:{...h,'Content-Type':'application/json'}})}});