import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const admin = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, Authorization, x-client-info, apikey"
};

const AUTH_EVENTS = new Set(["login", "logout", "failed_login"]);

serve(async (req: Request) => {
  if (req.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: corsHeaders });
  }

  try {
    const body = await req.json().catch(() => ({}));
    const action = String(body?.action || "").trim();

    if (!AUTH_EVENTS.has(action)) {
      return new Response(
        JSON.stringify({
          success: false,
          error: "This capability records authentication events only; record changes are captured by database audit triggers."
        }),
        { status: 403, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    const suppliedRecordId = body?.record_id == null
      ? null
      : String(body.record_id).trim().slice(0, 240) || null;

    const operationId = body?.operation_id == null
      ? null
      : String(body.operation_id).trim().slice(0, 240) || null;

    const eventData = body?.new_data ?? null;

    if (action === "failed_login") {
      const { error } = await admin.from("audit_log").insert({
        user_email: null,
        actor_user_id: null,
        company_id: null,
        action: "failed_login",
        table_name: "auth",
        record_id: suppliedRecordId,
        old_data: null,
        new_data: eventData,
        ip_address: req.headers.get("x-forwarded-for"),
        user_agent: req.headers.get("user-agent"),
        source_type: "application_event",
        operation_id: operationId
      });

      if (error) {
        console.error("audit failed_login insert:", error);
        return new Response(
          JSON.stringify({ success: false, error: error.message }),
          { status: 500, headers: { ...corsHeaders, "Content-Type": "application/json" } }
        );
      }

      return new Response(
        JSON.stringify({
          success: true,
          action: "failed_login",
          actor_user_id: null,
          company_id: null
        }),
        { status: 200, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    const authHeader = req.headers.get("Authorization") || "";
    const token = authHeader.replace(/^Bearer\s+/i, "").trim();

    if (!token) {
      return new Response(
        JSON.stringify({ success: false, error: "Authentication required" }),
        { status: 401, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    const { data: authData, error: authError } = await admin.auth.getUser(token);

    if (authError || !authData?.user?.id || !authData.user.email) {
      return new Response(
        JSON.stringify({ success: false, error: "Invalid session" }),
        { status: 401, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    const { data: actor, error: actorError } = await admin
      .from("users")
      .select("id, company_id, email, status")
      .eq("auth_id", authData.user.id)
      .maybeSingle();

    if (
      actorError ||
      !actor?.id ||
      !actor.company_id ||
      String(actor.status || "Active") === "Inactive"
    ) {
      return new Response(
        JSON.stringify({ success: false, error: "Authenticated user is not mapped to an active ERP user" }),
        { status: 403, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    const { error } = await admin.from("audit_log").insert({
      user_email: actor.email || authData.user.email,
      actor_user_id: actor.id,
      company_id: actor.company_id,
      action,
      table_name: "auth",
      record_id: authData.user.id,
      old_data: null,
      new_data: null,
      ip_address: req.headers.get("x-forwarded-for"),
      user_agent: req.headers.get("user-agent"),
      source_type: "application_event",
      operation_id: operationId
    });

    if (error) {
      console.error("audit auth event insert:", error);
      return new Response(
        JSON.stringify({ success: false, error: error.message }),
        { status: 500, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    return new Response(
      JSON.stringify({
        success: true,
        action,
        actor_user_id: actor.id,
        company_id: actor.company_id
      }),
      { status: 200, headers: { ...corsHeaders, "Content-Type": "application/json" } }
    );
  } catch (error) {
    console.error("Unexpected audit error:", error);
    return new Response(
      JSON.stringify({
        success: false,
        error: error instanceof Error ? error.message : String(error)
      }),
      { status: 500, headers: { ...corsHeaders, "Content-Type": "application/json" } }
    );
  }
});