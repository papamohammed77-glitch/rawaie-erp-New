// complete-loading — TASK-028 thin capability wrapper
// Target Core: public.complete_runsheet_loading(...)
// IMPORTANT: stock, inventory log, allocation, order quantities, backorder ledger,
// and Runsheet state are committed atomically inside PostgreSQL.

import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
)

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS"
}

serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders })
  }

  try {
    const authHeader = req.headers.get("Authorization")
    if (!authHeader) throw new Error("غير مصرح")

    const token = authHeader.replace("Bearer ", "")
    const { data: { user }, error: authError } = await supabase.auth.getUser(token)
    if (authError || !user) throw new Error("جلسة غير صالحة")

    const body = await req.json()
    const runsheet_code = body?.runsheet_code
    const rawItems = body?.items

    if (!runsheet_code || !Array.isArray(rawItems) || rawItems.length === 0) {
      throw new Error("البيانات غير مكتملة")
    }

    const { data: settings, error: settingsError } = await supabase
      .from("app_settings")
      .select("company_id")
      .limit(1)
      .maybeSingle()

    if (settingsError || !settings?.company_id) {
      throw new Error("سياق الشركة غير محدد")
    }

    const { data: runsheet, error: runsheetError } = await supabase
      .from("runsheets")
      .select("id, runsheet_code")
      .eq("company_id", settings.company_id)
      .eq("runsheet_code", runsheet_code)
      .maybeSingle()

    if (runsheetError || !runsheet) {
      throw new Error("الرانشيت غير موجود")
    }

    // Preserve the existing UI contract while normalizing names for the Core RPC.
    const items = rawItems.map((item: any) => ({
      item_code: item?.item_code ?? item?.itemCode,
      loaded_qty: Number(item?.loaded_qty ?? item?.loadedQty ?? 0)
    }))

    const invalid = items.some((item: any) => !item.item_code || item.loaded_qty <= 0)
    if (invalid) throw new Error("بيانات التحميل غير صالحة")

    const { data, error } = await supabase.rpc("complete_runsheet_loading", {
      p_company_id: settings.company_id,
      p_runsheet_id: runsheet.id,
      p_items: items,
      p_user_email: user.email
    })

    if (error) throw new Error(error.message)

    return new Response(JSON.stringify(data), {
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    })
  } catch (error: any) {
    console.error("❌ complete-loading error:", error?.message || error)

    return new Response(JSON.stringify({
      success: false,
      msg: error?.message || "فشل إنهاء التحميل"
    }), {
      status: 400,
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    })
  }
})
