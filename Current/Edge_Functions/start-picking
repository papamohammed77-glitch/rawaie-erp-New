serve(async(req)=>{if(req.method==="OPTIONS")return new Response("ok",{headers:corsHeaders});try{const rawBody=await req.text();let body:any={};if(rawBody.trim()){try{body=JSON.parse(rawBody)}catch{throw new Error("صيغة JSON غير صالحة")}}let runsheet_code=body?.runsheet_code;if(!runsheet_code&&body?.body){try{runsheet_code=typeof body.body==='string'?JSON.parse(body.body).runsheet_code:body.body.runsheet_code}catch{}};if(!runsheet_code)throw new Error("رقم الرانشيت مطلوب");const ah=req.headers.get("Authorization");if(!ah)throw new Error("غير مصرح");const {data:{user},error:ae}=await supabase.auth.getUser(ah.replace("Bearer ",""));if(ae||!user)throw new Error("جلسة غير صالحة");const {data:settings,error:se}=await supabase.from("app_settings").select("company_id").limit(1).maybeSingle();if(se||!settings?.company_id)throw new Error("سياق الشركة غير محدد");let {data:pubUser}=await supabase.from("users").select("id").eq("email",user.email).eq("company_id",settings.company_id).maybeSingle();if(!pubUser){const {data:newUser,error:ie}=await supabase.from("users").insert({id:user.id,email:user.email,name:user.user_metadata?.name||user.email,role:user.user_metadata?.role||'مخزني',permissions:user.user_metadata?.permissions||[],company_id:settings.company_id,status:'Active'}).select("id").single();if(ie)throw new Error("فشل إضافة المستخدم: "+ie.message);pubUser=newUser}
