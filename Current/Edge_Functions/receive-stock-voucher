// receive-stock-voucher — thin capability wrapper
// Physical stock movement is delegated to post_manual_stock_voucher_atomic → post_stock_movement.
import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
)

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
}

serve(async (req) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders })

  try {
    const body = await req.json().catch(() => ({}))
    const voucher_code = body?.voucher_code
    const receivedItems = body?.receivedItems
    if (!voucher_code || !Array.isArray(receivedItems) || receivedItems.length === 0) {
      throw new Error("البيانات غير مكتملة")
    }

    const authHeader = req.headers.get("Authorization")
    if (!authHeader) throw new Error("غير مصرح")
    const token = authHeader.replace("Bearer ", "")
    const { data: { user }, error: authError } = await supabase.auth.getUser(token)
    if (authError || !user?.email) throw new Error("جلسة غير صالحة")

    const { data: settings, error: settingsError } = await supabase
      .from("app_settings")
      .select("company_id")
      .limit(1)
      .maybeSingle()
    if (settingsError || !settings?.company_id) throw new Error("سياق الشركة غير محدد")

    const { data: voucher, error: voucherError } = await supabase
      .from("stock_vouchers")
      .select("id,status")
      .eq("company_id", settings.company_id)
      .eq("voucher_code", voucher_code)
      .maybeSingle()
    if (voucherError || !voucher) throw new Error("الإذن غير موجود")

    const effects = []
    for (const item of receivedItems) {
      const receivedQty = Number(item?.receivedQty ?? 0)
      if (receivedQty <= 0) continue
      const itemCode = item?.itemCode
      if (!itemCode) throw new Error("كود الصنف مطلوب")

      const { data: itemRow, error: itemError } = await supabase
        .from("items")
        .select("id,item_code")
        .eq("company_id", settings.company_id)
        .eq("item_code", itemCode)
        .maybeSingle()
      if (itemError || !itemRow) throw new Error("الصنف غير موجود: " + itemCode)

      const { data: detail, error: detailError } = await supabase
        .from("stock_voucher_details")
        .select("qty,received_qty")
        .eq("voucher_id", voucher.id)
        .eq("item_id", itemRow.id)
        .eq("item_code", itemCode)
        .maybeSingle()
      if (detailError || !detail) throw new Error("الصنف غير موجود في تفاصيل الإذن: " + itemCode)

      effects.push({
        direction: "IN",
        branch_id: null,
        item_id: itemRow.id,
        item_code: itemCode,
        qty: receivedQty,
      })
    }

    // Resolve destination branch from voucher metadata; the Core validates the branch/company context.
    const { data: destination } = await supabase
      .from("stock_vouchers")
      .select("to_id")
      .eq("id", voucher.id)
      .single()
    if (!destination?.to_id) throw new Error("وجهة الإذن غير محددة")
    for (const effect of effects) effect.branch_id = destination.to_id

    const { data, error } = await supabase.rpc("post_manual_stock_voucher_atomic", {
      p_company_id: settings.company_id,
      p_voucher_code: voucher_code,
      p_operation: "RECEIVE",
      p_user_email: user.email,
      p_effects: effects,
    })
    if (error) throw new Error(error.message)

    return new Response(JSON.stringify(data), {
      headers: { ...corsHeaders, "Content-Type": "application/json" },
    })
  } catch (error: any) {
    return new Response(JSON.stringify({ success: false, msg: error?.message || "فشل استلام الإذن" }), {
      status: 400,
      headers: { ...corsHeaders, "Content-Type": "application/json" },
    })
  }
})