var actions={dashboard:renderDashboard,customers:function(){return renderList('العملاء','customers',['customer_code','name','phone','area','debt','is_active'],'customer_code')},suppliers:function(){return renderList('الموردون','suppliers',['supplier_code','name','phone','area','accounts_payable','is_active'],'supplier_code')},items:function(){return renderList('الأصناف','items',['item_code','name','unit','sales_price','cost_price','is_active'],'item_code')},orders:function(){return renderList('الطلبات','orders',['order_code','order_date','customer_name','total_amount','order_status','payment_type'],'created_at')},runsheets:function(){return renderList('الرانشيت','runsheets',['runsheet_code','run_date','status','driver_id','vehicle_id','total_amount'],'run_date')},purchases:function(){return renderList('أوامر الشراء','purchase_orders',['po_code','po_date','supplier_name','total_amount','status','branch_id'],'po_date')},inventory:renderInventory,finance:renderFinance,reports:renderReports,hr:renderHR,settings:renderSettings,pos:renderPOS,receiving:renderReceiving,vouchers:renderVouchers,warehouse:renderWarehouse};
window.RW_Views.actions=actions;window.RW_Views.open=function(v){return openView(v)};window.RW_Dashboard.render=renderDashboard;window.RW_Items.render=function(){return actions.items()};window.RW_POS.open=renderPOS;window.RW_Orders.render=function(){return actions.orders()};window.RW_Runsheets.render=function(){return actions.runsheets()};window.RW_Purchases.open=renderReceiving;window.RW_Warehouse.open=renderWarehouse;window.RW_Finance.render=renderFinance;window.RW_Reports.render=renderReports;window.RW_HR.render=renderHR;window.RW_CRM.render=function(){return actions.customers()};
async function openView(view){STATE.view=view;Array.prototype.forEach.call(byId('sidebar').querySelectorAll('.nav'),function(x){x.classList.toggle('active',x.getAttribute('data-view')===view)});if(!actions[view])return;try{await actions[view]()}catch(e){byId('content').innerHTML='<div class="notice bad">'+esc(e&&e.message?e.message:e)+'</div>'}}
async function boot(authUser){clearError();try{await authoritativeContext(authUser);renderNav();showApp();byId('companyPill').textContent=(STATE.company&&STATE.company.name)||'الشركة';byId('userPill').textContent=STATE.user.name||STATE.user.email;online();await openView('dashboard')}catch(e){await client.auth.signOut();showLogin();setError(e.message||'فشل تهيئة الجلسة')}}
async function login(){clearError();var email=(byId('loginEmail').value||'').trim(),password=byId('loginPassword').value||'';if(!email||!password){setError('أدخل البريد وكلمة المرور');return}byId('loginButton').disabled=true;try{var r=await client.auth.signInWithPassword({email:email,password:password});if(r.error)throw r.error;await boot(r.data.user)}catch(e){setError(e.message||'فشل تسجيل الدخول')}finally{byId('loginButton').disabled=false}}
byId('loginButton').addEventListener('click',login);byId('loginPassword').addEventListener('keydown',function(e){if(e.key==='Enter')login()});byId('logoutButton').addEventListener('click',async function(){await client.auth.signOut();location.reload()});byId('menuButton').addEventListener('click',function(){byId('sidebar').classList.toggle('open')});window.addEventListener('online',online);window.addEventListener('offline',online);client.auth.onAuthStateChange(function(event,session){if(event==='SIGNED_OUT')showLogin();else if((event==='SIGNED_IN'||event==='INITIAL_SESSION')&&session&&session.user)boot(session.user)});client.auth.getSession().then(function(r){if(r.data&&r.data.session)boot(r.data.session.user);else showLogin()}).catch(function(e){showLogin();setError(e.message||'فشل تهيئة الجلسة')});online();
if('serviceWorker' in navigator){navigator.serviceWorker.register('../sw.js',{scope:'../'}).catch(function(e){console.warn('[RW] Service Worker registration failed',e)})}
})();
