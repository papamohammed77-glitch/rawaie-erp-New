function msg(text,type){var x=type==='error'?el('loginMsg'):null;if(x){x.textContent=text;x.style.display='block';return}alert(text)}
function setContent(html){el('content').innerHTML=html}
function setTitle(t,s){el('headerTitle').textContent=t;el('headerSubtitle').textContent=s||'الروائع ERP'}
function token(){return sb.auth.getSession().then(function(r){var s=r&&r.data&&r.data.session;if(!s||!s.access_token)throw new Error('SESSION_UNAVAILABLE');return s.access_token})}
function edgeCall(name,body,opts){return token().then(function(t){var h={'Content-Type':'application/json','Authorization':'Bearer '+t};if(opts&&opts.idempotencyKey)h['Idempotency-Key']=opts.idempotencyKey;return fetch(RW_SUPABASE_URL+'/functions/v1/'+name,{method:'POST',headers:h,body:JSON.stringify(body||{})})}).then(function(r){return r.json().catch(function(){return {}}).then(function(j){if(!r.ok||j.success===false)throw new Error(j.msg||j.error||('Edge failure: '+name));return j})})}

window.RW_STATE={app:{currentUser:null,companyId:null,company:null,licenseState:'unknown'},permissions:[]};
window.RW_ShellContext={
 getCompanyId:function(){var c=RW_STATE.app.companyId;if(!c)throw new Error('TENANT_CONTEXT_UNAVAILABLE');return c},
 getCurrentUser:function(){return RW_STATE.app.currentUser},
 isOwner:function(){return !!(RW_STATE.app.currentUser&&RW_STATE.app.currentUser.isOwner===true)},
 getPermissions:function(){return Array.isArray(RW_STATE.permissions)?RW_STATE.permissions:[]},
 can:function(p){return this.isOwner()||this.getPermissions().indexOf('*')>=0||this.getPermissions().indexOf(p)>=0},
 async bootstrap:function(){var r=await sb.auth.getSession();var s=r&&r.data&&r.data.session;if(!s){this.showLogin();return false}return this.hydrate(s.user)},
 async hydrate:function(authUser){var ures=await sb.from('users').select('id,name,role,company_id,status').eq('auth_id',authUser.id).maybeSingle();if(ures.error||!ures.data||!ures.data.company_id)throw new Error('USER_COMPANY_CONTEXT_UNAVAILABLE');if(ures.data.status&&ures.data.status!=='Active')throw new Error('USER_INACTIVE');var meta=authUser.user_metadata||{};var isOwner=meta.isOwner===true||meta.isOwner==='true'||meta.role==='owner'||meta.role==='مالك';RW_STATE.app.currentUser={id:ures.data.id,email:authUser.email,name:ures.data.name||meta.name||authUser.email,role:ures.data.role||meta.role||'',isOwner:isOwner,owner_profile:meta.owner_profile||null,licenseState:meta.license_state||meta.licenseStatus||'unknown'};RW_STATE.permissions=Array.isArray(meta.permissions)?meta.permissions.slice():[];RW_STATE.app.companyId=ures.data.company_id;RW_STATE.app.licenseState=RW_STATE.app.currentUser.licenseState;var cres=await sb.from('companies').select('*').eq('id',ures.data.company_id).maybeSingle();RW_STATE.app.company=cres.data||null;RW_OwnerLicense.sync();renderShell();await RW_Views.open('dashboard');return true},
 async login:function(){var e=(el('loginEmail').value||'').trim(),p=el('loginPassword').value||'';if(!e||!p)return msg('أدخل البريد وكلمة المرور','error');try{var r=await sb.auth.signInWithPassword({email:e,password:p});if(r.error)throw r.error;await this.hydrate(r.data.user)}catch(x){msg(x.message||'فشل تسجيل الدخول','error')}},
 async logout:function(){await sb.auth.signOut();RW_STATE.app.currentUser=null;RW_STATE.app.companyId=null;this.showLogin()},
 showLogin:function(){el('loginScreen').style.display='flex';el('app').style.display='none'},
 toggleDrawer:function(force){var d=el('drawer');if(force===false)d.classList.remove('open');else d.classList.toggle('open');el('drawerPanel').innerHTML=el('sidebar').innerHTML},
 online:function(){el('onlinePill').textContent=navigator.onLine?'متصل':'غير متصل';el('onlinePill').style.background=navigator.onLine?'#dcfce7':'#fee2e2';el('onlinePill').style.color=navigator.onLine?'#047857':'#b91c1c'}
};

window.RW_OwnerLicense={sync:function(){var u=RW_STATE.app.currentUser||{};RW_STATE.app.licenseState=u.licenseState||'unknown';},isOwner:function(){return RW_ShellContext.isOwner()},hasFullPermission:function(){return RW_ShellContext.isOwner()||RW_ShellContext.getPermissions().indexOf('*')>=0},status:function(){return RW_STATE.app.licenseState||'unknown'}};

window.RW_API={call:function(name,body,opts,cb){edgeCall(name,body,opts).then(function(j){if(cb)cb(j,null)}).catch(function(e){if(cb)cb({success:false,msg:e.message},e)})},callAsync:edgeCall};

window.RW_Realtime={channels:[],start:function(){var cid=RW_ShellContext.getCompanyId();try{var c=sb.channel('rw-new-main-'+cid).on('postgres_changes',{event:'*',schema:'public',table:'orders',filter:'company_id=eq.'+cid},function(){RW_Views.refresh()}).on('postgres_changes',{event:'*',schema:'public',table:'stock_branches'},function(){if(RW_Views.current==='inventory'||RW_Views.current==='dashboard')RW_Views.refresh()}).subscribe();this.channels.push(c)}catch(e){console.warn(e)}},stop:function(){this.channels.forEach(function(c){sb.removeChannel(c)});this.channels=[]}};

window.RW_Offline={key:function(k){return 'rw-new-main:'+RW_ShellContext.getCompanyId()+':'+k},put:function(k,v){try{localStorage.setItem(this.key(k),JSON.stringify({ts:Date.now(),data:v}))}catch(e){}},get:function(k){try{var r=JSON.parse(localStorage.getItem(this.key(k))||'null');return r?r.data:null}catch(e){return null}},status:function(){return navigator.onLine?'online':'offline'}};

function moduleLinks(){return [
 ['dashboard','📊','لوحة التحكم','dashboard:view'],
 ['customers','👥','العملاء','customers:view'],
 ['suppliers','🚚','الموردون','suppliers:view'],
 ['items','📦','الأصناف','items:view'],
 ['pos','🧾','نقطة البيع','pos:use'],
 ['orders','🛒','الطلبات','orders:view'],
 ['runsheets','🚛','الرانشيت','runsheets:view'],
 ['purchases','📝','المشتريات','purchases:view'],
 ['receiving','📥','الاستلام','receiving:view'],
 ['inventory','🏬','المخزون','inventory:view'],
 ['vouchers','🔄','أذونات المخزون','vouchers:view'],
 ['warehouse','🧰','عمليات المخزن','warehouse:view'],
 ['finance','💰','الحسابات','finance:view'],
 ['reports','📈','التقارير','reports:view'],
 ['hr','🧑‍💼','الموارد البشرية','hr:view'],
 ['crm','📇','CRM','crm:view'],
 ['settings','⚙️','الإعدادات','settings:view']
]}
function navHtml(){var a='<div class="card" style="margin-bottom:12px"><div style="font-weight:900">'+esc((RW_STATE.app.company&&RW_STATE.app.company.name)||'الشركة الحالية')+'</div><div class="muted" style="font-size:11px">'+esc(RW_STATE.app.companyId)+'</div></div>';a+='<div class="nav-group">';moduleLinks().forEach(function(x){a+='<button class="nav-btn" data-view="'+x[0]+'" onclick="RW_Views.open(\''+x[0]+'\');if(window.innerWidth<=1050)RW_ShellContext.toggleDrawer(false)"><span>'+x[1]+'</span><span>'+x[2]+'</span></button>'});a+='</div>';a+='<div class="card" style="font-size:11px"><b>OWNER</b><div class="muted">isOwner: '+String(RW_ShellContext.isOwner())+'<br>permissions: '+esc(RW_ShellContext.getPermissions().join(', ')||'—')+'<br>license: '+esc(RW_OwnerLicense.status())+'</div></div>';return a}
function renderShell(){el('loginScreen').style.display='none';el('app').style.display='block';el('sidebar').innerHTML=navHtml();el('companyPill').textContent=(RW_STATE.app.company&&RW_STATE.app.company.name)||'Company';el('userPill').textContent=RW_STATE.app.currentUser.name||RW_STATE.app.currentUser.email;RW_ShellContext.online();RW_Realtime.stop();RW_Realtime.start()}

function listModule(title,table,fields,opts){return async function(){setTitle(title,'قراءة company-scoped');setContent('<div class="card"><div class="section-head"><h2>'+title+'</h2><div class="actions"><button class="btn btn-ghost" onclick="RW_Views.refresh()">تحديث</button></div></div><div id="listArea"><div class="empty">جاري التحميل…</div></div></div>');var q=sb.from(table).select(fields||'*').eq('company_id',RW_ShellContext.getCompanyId());if(opts&&opts.order)q=q.order(opts.order);var r=await q;if(r.error)throw r.error;var rows=r.data||[];RW_Offline.put(table,rows);var html=rows.length?'<div class="table-wrap"><table class="table"><thead><tr>'+fields.split(',').map(function(f){return '<th>'+esc(f)+'</th>'}).join('')+'</tr></thead><tbody>'+rows.slice(0,250).map(function(row){return '<tr>'+fields.split(',').map(function(f){return '<td>'+esc(row[f])+'</td>'}).join('')+'</tr>'}).join('')+'</tbody></table></div>':'<div class="empty">لا توجد بيانات</div>';el('listArea').innerHTML=html}}

window.RW_Dashboard={async render(){setTitle('لوحة التحكم','الحقيقة التشغيلية من Production');setContent('<div class="grid grid-4"><div class="card kpi"><div class="k">العملاء</div><div class="v" id="kCustomers">…</div></div><div class="card kpi"><div class="k">الأصناف</div><div class="v" id="kItems">…</div></div><div class="card kpi"><div class="k">رصيد المخزون</div><div class="v" id="kStock">…</div></div><div class="card kpi"><div class="k">طلبات اليوم</div><div class="v" id="kOrders">…</div></div></div><div class="grid grid-2" style="margin-top:16px"><div class="card"><div class="section-head"><h2>الوصول السريع</h2></div><div class="actions"><button id="rec-purchase" class="btn btn-primary" onclick="RW_Views.open(\'purchases\')">المشتريات</button><button id="rec-offers" class="btn btn-ghost" onclick="RW_Views.open(\'items\')">العروض / الأصناف</button><button class="btn btn-ghost" onclick="RW_Views.open(\'vouchers\')">الأذونات</button><button class="btn btn-ghost" onclick="RW_Views.open(\'warehouse\')">المخزن</button></div></div><div class="card"><div class="section-head"><h2>حالة النظام</h2></div><div id="healthBox" class="muted">جاري الفحص…</div></div></div>');var c=RW_ShellContext.getCompanyId();var ps=[sb.from('customers').select('id',{count:'exact',head:true}).eq('company_id',c),sb.from('items').select('id',{count:'exact',head:true}).eq('company_id',c),sb.from('stock_branches').select('qty').eq('branch_id',RW_STATE.app.company?RW_STATE.app.company.main_branch_id:null),sb.from('orders').select('id',{count:'exact',head:true}).eq('company_id',c).eq('order_date',today())];var rr=await Promise.all(ps);el('kCustomers').textContent=rr[0].count||0;el('kItems').textContent=rr[1].count||0;el('kStock').textContent=fmt((rr[2].data||[]).reduce(function(s,x){return s+Number(x.qty||0)},0));el('kOrders').textContent=rr[3].count||0;el('healthBox').innerHTML='<div class="success">Production connection OK · tenant '+esc(c)+'</div>'}}

window.RW_Items=listModule('الأصناف','items','id,item_code,name,unit,sales_price,cost_price,is_active',{order:'item_code'});
