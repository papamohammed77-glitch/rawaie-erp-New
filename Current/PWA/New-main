(){delegated('الاستلام',[['📥','../buyer.html#receiving','Receiving','استلام المشتريات']],'Physical movement remains a backend responsibility.')},vouchers:function(){delegated('الأذونات',[['🔄','../vouchers.html','Stock Vouchers','دورة الأذونات']],'New-main لا يكتب المخزون مباشرة.')},picking:function(){delegated('التحضير',[['🧺','../picker.html','Picker','Reservation / Picking']],'Reservation remains reserve_stock/release_stock_reservation.')},loading:function(){delegated('التحميل',[['📦','../loader.html','Loader','Loading lifecycle']],'Physical movement is delegated to backend core.')},delivery:function(){delegated('التوصيل',[['🚚','../driver.html','Driver','Delivery execution']],'Delivery lifecycle remains in specialized application.')},returns:function(){delegated('المرتجعات',[['↩️','../Returns.html','Returns','Returns lifecycle']],'Returns remain specialized workflow.')}};
