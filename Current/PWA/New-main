async function openView(v){STATE.view=v;Array.prototype.forEach.call(byId('sidebar').querySelectorAll('.nav'),function(x){x.classList.toggle('active',x.getAttribute('data-view')===v)});if(!actions[v])return;try{await actions[v]()}catch(e){byId('content').innerHTML='<div class="notice bad">'+esc(errText(e))+'</div>'}}
async function boot(authUser){try{await authoritativeContext(authUser);renderNav();byId('companyPill').textContent=(STATE.company&&STATE.company.name)||'الشركة';byId('userPill').textContent=STATE.user.name||STATE.user.email;byId('app').classList.remove('hidden');byId('login').classList.add('hidden');online();await openView('dashboard')}catch(e){await sb.auth.signOut().catch(function(){});byId('app').classList.add('hidden');byId('login').classList.remove('hidden');byId('loginError').textContent=errText(e);byId('loginError').classList.remove('hidden')}}
async function login(){var email=byId('loginEmail').value.trim(),password=byId('loginPassword').value;if(!email||!password){byId('loginError').textContent='أدخل البريد وكلمة المرور';byId('loginError').classList.remove('hidden');return}byId('loginButton').disabled=true;try{var r=await sb.auth.signInWithPassword({email:email,password:password});if(r.error)throw r.error;await boot(r.data.user)}catch(e){byId('loginError').textContent=errText(e);byId('loginError').classList.remove('hidden')}finally{byId('loginButton').disabled=false}}
byId('loginButton').onclick=login;byId('loginPassword').onkeydown=function(e){if(e.key==='Enter')login()};byId('logoutButton').onclick=async function(){await sb.auth.signOut();location.reload()};byId('menuButton').onclick=function(){byId('sidebar').classList.toggle('open')};byId('globalSearch').oninput=function(){var self=this;clearTimeout(STATE.searchTimer);STATE.searchTimer=setTimeout(function(){globalSearch(self.value)},280)};window.addEventListener('online',online);window.addEventListener('offline',online);sb.auth.onAuthStateChange(function(event,session){if(event==='SIGNED_OUT')byId('login').classList.remove('hidden');else if((event==='SIGNED_IN'||event==='INITIAL_SESSION')&&session&&session.user)boot(session.user)});sb.auth.getSession().then(function(r){if(r.data&&r.data.session)boot(r.data.session.user)}).catch(function(e){console.error(e)});if('serviceWorker' in navigator){navigator.serviceWorker.register('../sw.js',{scope:'../'}).catch(function(e){console.warn('[RW] SW registration failed',e)})}online();
