    <aside class="sidebar" id="sidebar"></aside>
    <main class="main"><div id="content"></div></main>
  </div>
</div>
<div class="drawer" id="drawer" onclick="if(event.target===this) RW_ShellContext.toggleDrawer(false)"><div class="drawer-panel" id="drawerPanel"></div></div>
