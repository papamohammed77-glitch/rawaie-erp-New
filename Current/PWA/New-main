        if (!sel || !area) return;
        var customers = RW_STATE.data.customers || [];
        var found = null;
        for (var i = 0; i < customers.length; i++) {
            if (customers[i].customer_code === sel.value || customers[i].code === sel.value) {
                found = customers[i];
                break;
            }
        }
        area.value = found ? (found.area || '') : '';
