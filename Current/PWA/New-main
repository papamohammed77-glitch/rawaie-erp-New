refresh:function(){return this.render()}};
window.RW_Warehouse={render:function(){setTitle('عمليات المخزن','Capabilities حالية');setContent('<div class="grid grid-2"><div class="card"><h2>Picker</h2><p class="muted">الواجهة الحالية المتخصصة.</p><a class="btn btn-primary" href="picker.html">فتح Picker</a></div><div class="card"><h2>Van Sales</h2><p class="muted">التطبيق الحالي المتخصص.</p><a class="btn btn-primary" href="van-sales.html">فتح Van Sales</a></div><div class="card"><h2>Stock Vouchers</h2><p class="muted">دورة الأذونات الحالية.</p><a class="btn btn-primary" href="vouchers.html">فتح الأذونات</a></div><div class="card"><h2>Returns</h2><p class="muted">قدرة المرتجعات الحالية.</p><a class="btn btn-primary" href="Returns.html">فتح المرتجعات</a></div></div>')}};
window.RW_Finance=listModule('الحسابات','journal_entries','id,entry_code,entry_date,reference,description,entry_type,status,created_by',{order:'entry_date'});
window.RW_Reports={async render(){setTitle('التقارير','Read-only reporting capability');var c=RW_ShellContext.getCompanyId();var o=await sb.from('orders').select('order_date,total_amount,order_status,payment_type').eq('company_id',c).order('order_date',{ascending:false}).limit(200);var total=(o.data||[]).reduce(function(s,x){return s+Number(x.total_amount||0)},0);setContent('<div class="grid grid-3"><div class="card kpi"><div class="k">عدد السجلات المعروضة</div><div class="v">'+(o.data||[]).length+'</div></div><div class="card kpi"><div class="k">إجمالي قيمة الطلبات المعروضة</div><div class="v">'+fmt(total)+'</div></div><div class="card kpi"><div class="k">التاريخ</div><div class="v">'+today()+'</div></div></div><div class="card" style="margin-top:16px"><div class="section-head"><h2>آخر الطلبات</h2></div><div class="table-wrap"><table class="table"><thead><tr><th>التاريخ</th><th>القيمة</th><th>الحالة</th><th>الدفع</th></tr></thead><tbody>'+((o.data||[]).map(function(x){return '<tr><td>'+esc(x.order_date)+'</td><td>'+fmt(x.total_amount)+'</td><td>'+esc(x.order_status)+'</td><td>'+esc(x.payment_type)+'</td></tr>'}).join('')||'<tr><td colspan="4">لا توجد بيانات</td></tr>')+'</tbody></table></div></div>')}};
window.RW_HR={async render(){setTitle('الموارد البشرية','Company-scoped users');var c=RW_ShellContext.getCompanyId();var r=await sb.from('users').select('id,name,email,role,status,active_warehouse_role').eq('company_id',c).order('name');if(r.error)throw r.error;setContent('<div class="card"><div class="section-head"><h2>المستخدمون</h2></div><div class="table-wrap"><table class="table"><thead><tr><th>الاسم</th><th>البريد</th><th>الدور</th><th>الحالة</th><th>دور المخزن</th></tr></thead><tbody>'+((r.data||[]).map(function(x){return '<tr><td>'+esc(x.name)+'</td><td>'+esc(x.email)+'</td><td>'+esc(x.role)+'</td><td>'+esc(x.status)+'</td><td>'+esc(x.active_warehouse_role)+'</td></tr>'}).join('')||'<tr><td colspan="5">لا توجد بيانات</td></tr>')+'</tbody></table></div></div>')}};
window.RW_CRM={render:function(){return RW_Customers()}};
window.RW_Settings={async render(){setTitle('الإعدادات','Company scoped');var c=RW_ShellContext.getCompanyId();var r=await sb.from('app_settings').select('*').eq('company_id',c).maybeSingle();if(r.error)throw r.error;setContent('<div class="grid grid-2"><div class="card"><h2>السياق</h2><p><b>Company ID:</b> '+esc(c)+'</p><p><b>User:</b> '+esc(RW_STATE.app.currentUser.email)+'</p><p><b>OWNER:</b> '+String(RW_ShellContext.isOwner())+'</p><p><b>License:</b> '+esc(RW_OwnerLicense.status())+'</p></div><div class="card"><h2>الإعدادات الحالية</h2><pre style="white-space:pre-wrap;word-break:break-word;font-size:11px">'+esc(JSON.stringify(r.data||{},null,2))+'</pre></div></div>')}};
window.RW_POS={cart:[],render:function(){setTitle('نقطة البيع','Transactional write delegates to save-sales-invoice');var self=this;setContent('<div class="grid grid-2"><div class="card"><div class="section-head"><h2>اختيار الأصناف</h2><button class="btn btn-ghost" onclick="RW_POS.loadItems()">تحميل</button></div><div id="posItems"><div class="empty">اضغط تحميل</div></div></div><div class="card"><div class="section-head"><h2>السلة</h2><button class="btn btn-danger" onclick="RW_POS.cart=[];RW_POS.renderCart()">تفريغ</button></div><div id="posCart"></div><div class="actions" style="margin-top:12px"><button class="btn btn-primary" onclick="RW_POS.submit()">حفظ الفاتورة</button></div></div></div>');this.renderCart()},async loadItems(){var r=await sb.from('items').select('id,item_code,name,unit,sales_price').eq('company_id',RW_ShellContext.getCompanyId()).eq('is_active',true).order('item_code').limit(250);if(r.error)return msg(r.error.message,'error');el('posItems').innerHTML=(r.data||[]).map(function(x){return '<div class="card" style="padding:10px;margin:7px 0"><div style="font-weight:900">'+esc(x.item_code)+' — '+esc(x.name)+'</div><div class="muted" style="font-size:11px">'+esc(x.unit)+' · '+fmt(x.sales_price)+'</div><div class="actions" style="margin-top:7px"><button class="btn btn-ghost" onclick="RW_POS.add(\''+esc(x.id)+'\',\''+esc(x.item_code)+'\',\''+esc(x.name).replace(/'/g,'&#39;')+'\','+Number(x.sales_price||0)+',1)">إضافة</button></div></div>'}).join('')||'<div class="empty">لا توجد أصناف</div>'},add:function(id,code,name,price,qty){var x=this.cart.find(function(a){return a.id===id});if(x)x.qty+=qty;else this.cart.push({id:id,code:code,name:name,price:Number(price)||0,qty:qty});this.renderCart()},renderCart:function(){var total=this.cart.reduce(function(s,x){return s+x.price*x.qty},0);el('posCart').innerHTML=this.cart.length?this.cart.map(function(x,i){return '<div style="display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid #eef2f7;padding:9px 0"><div><b>'+esc(x.code)+'</b><div class="muted" style="font-size:11px">'+esc(x.name)+'</div></div><div>'+x.qty+' × '+fmt(x.price)+'</div><button class="btn btn-danger" onclick="RW_POS.cart.splice('+i+',1);RW_POS.renderCart()">×</button></div>'}).join('')+'<div style="font-weight:900;font-size:17px;margin-top:12px">الإجمالي: '+fmt(total)+'</div>':'<div class="empty">السلة فارغة</div>'},async submit(){if(!this.cart.length)return msg('السلة فارغة','error');var branch=RW_STATE.app.company&&RW_STATE.app.company.main_branch_code||'MAIN';var body={orderHeader:{custName:'POS Customer',customer_code:null,total:this.cart.reduce(function(s,x){return s+x.price*x.qty},0),status:'Invoiced',paymentType:'نقدي',source:'pos'},itemsList:this.cart.map(function(x){return {code:x.code,name:x.name,unit:'حبة',price:x.price,qty:x.qty}}),branchCode:branch};try{var r=await edgeCall('save-sales-invoice',body);msg('تم حفظ الفاتورة '+(r.orderID||''),'ok');this.cart=[];this.renderCart();RW_Views.open('orders')}catch(e){msg(e.message,'error')}}};
window.RW_Receiving={render:function(){setTitle('الاستلام','Production contract-aware');setContent('<div class="card"><h2>الاستلام</h2><p class="muted">الـProduction RPC الحالي يتطلب <b>p_operation_id</b> ويملك idempotency عبر receiving.operation_id. أي تنفيذ كتابي من هذه الواجهة يجب أن يمر عبر Edge contract المتوافق معه.</p><div class="actions"><button class="btn btn-primary" onclick="RW_Views.open(\'purchases\')">عرض أوامر الشراء</button></div></div>')}};
window.RW_Vouchers={render:function(){setTitle('أذونات المخزون','Capability delegation');setContent('<div class="card"><h2>أذونات المخزون</h2><p class="muted">لا توجد كتابة مخزنية من New-main. الحركة الفعلية ملك للـEdge/RPC.</p><div class="actions"><a class="btn btn-primary" href="vouchers.html">فتح شاشة الأذونات الحالية</a></div></div>')}};

window.RW_Views={current:'dashboard',modules:{dashboard:RW_Dashboard,customers:RW_Customers,suppliers:RW_Suppliers,items:RW_Items,pos:RW_POS,orders:RW_Orders,runsheets:RW_Runsheets,purchases:RW_Purchases,receiving:RW_Receiving,inventory:RW_Inventory,vouchers:RW_Vouchers,warehouse:RW_Warehouse,finance:RW_Finance,reports:RW_Reports,hr:RW_HR,crm:RW_CRM,settings:RW_Settings},open:async function(name){var m=this.modules[name];if(!m)return;this.current=name;document.querySelectorAll('.nav-btn').forEach(function(x){x.classList.toggle('active',x.getAttribute('data-view')===name)});try{if(typeof m==='function')await m();else if(m&&typeof m.render==='function')await m.render()}catch(e){setContent('<div class="error"><b>فشل تحميل '+esc(name)+'</b><div style="margin-top:6px">'+esc(e.message||e)+'</div></div>')}},refresh:function(){return this.open(this.current)}};

window.RW_Audit_log=function(action,tableName,recordId,oldData,newData){return edgeCall('log-action',{action:action,table_name:tableName,record_id:recordId,old_data:oldData,new_data:newData}).catch(function(e){console.warn('audit',e)})};
window.RW_Table={paginate:function(id,data,page,size,renderRow){var start=((page||1)-1)*(size||50),end=start+(size||50),rows=data.slice(start,end);var b=el(id);if(b)b.innerHTML=rows.map(renderRow).join('')}};

window.addEventListener('online',RW_ShellContext.online);window.addEventListener('offline',RW_ShellContext.online);
sb.auth.onAuthStateChange(function(event,session){if(event==='SIGNED_OUT')RW_ShellContext.showLogin();else if(event==='SIGNED_IN'&&session&&session.user)RW_ShellContext.hydrate(session.user).catch(function(e){msg(e.message,'error')})});
RW_ShellContext.bootstrap().catch(function(e){console.error(e);RW_ShellContext.showLogin();msg(e.message||'فشل تهيئة النظام','error')});
})();
</script>
