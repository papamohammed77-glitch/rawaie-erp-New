*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Cairo,Tahoma,Arial,sans-serif;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer}
#loginScreen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;background:linear-gradient(135deg,#0f172a 0%,#1e3a8a 38%,#2563eb 100%)}
.login-card{width:min(460px,94vw);background:#fff;border-radius:28px;padding:34px;box-shadow:0 30px 90px rgba(0,0,0,.22)}
.brand{display:flex;align-items:center;gap:14px;margin-bottom:28px}.brand-badge{width:58px;height:58px;border-radius:18px;background:linear-gradient(135deg,var(--p),#06b6d4);color:#fff;display:grid;place-items:center;font-weight:900;font-size:25px}.brand h1{margin:0;font-size:24px}.brand p{margin:4px 0 0;color:var(--muted);font-size:12px}
.field{margin:14px 0}.field label{display:block;font-size:13px;font-weight:800;margin-bottom:7px}.field input,.field select,.field textarea{width:100%;border:1px solid var(--border);border-radius:13px;padding:12px 13px;outline:none;background:#fff}.field input:focus,.field select:focus,.field textarea:focus{border-color:#93c5fd;box-shadow:0 0 0 4px rgba(37,99,235,.08)}
.btn{border:0;border-radius:13px;padding:11px 15px;font-weight:800}.btn-primary{background:var(--p);color:#fff}.btn-primary:hover{background:var(--pd)}.btn-ghost{background:#eef2ff;color:#1d4ed8}.btn-danger{background:#fee2e2;color:#b91c1c}.btn-ok{background:#dcfce7;color:#047857}
#app{display:none;min-height:100vh}.topbar{position:sticky;top:0;z-index:20;height:72px;background:#fff;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px}.topbar-left,.topbar-right{display:flex;align-items:center;gap:10px}.hamb{width:42px;height:42px;border:0;background:#eef2ff;color:#2563eb;border-radius:12px;font-size:18px}.title{font-size:20px;font-weight:900}.subtitle{font-size:11px;color:var(--muted)}.pill{padding:6px 9px;border-radius:999px;font-size:11px;font-weight:900;background:#f1f5f9;color:#334155}
.layout{display:flex;min-height:calc(100vh - 72px)}.sidebar{width:278px;background:#fff;border-left:1px solid var(--border);padding:16px;position:fixed;right:0;top:72px;bottom:0;overflow:auto;z-index:15}.main{width:100%;margin-right:278px;padding:22px}.nav-group{margin:8px 0 12px}.nav-label{font-size:11px;font-weight:900;color:#94a3b8;padding:8px}.nav-btn{width:100%;display:flex;align-items:center;gap:10px;border:0;background:transparent;padding:11px 12px;border-radius:12px;text-align:right;color:#475569;font-weight:800}.nav-btn:hover,.nav-btn.active{background:#eff6ff;color:#1d4ed8}.nav-btn span:first-child{width:24px;text-align:center}
.grid{display:grid;gap:16px}.grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}.grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.card{background:var(--card);border:1px solid var(--border);border-radius:20px;box-shadow:var(--shadow);padding:18px}.kpi .k{color:var(--muted);font-size:12px;font-weight:800}.kpi .v{font-size:29px;font-weight:900;margin-top:7px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:15px}.section-head h2{margin:0;font-size:18px}.actions{display:flex;gap:8px;flex-wrap:wrap}.table-wrap{overflow:auto;border:1px solid var(--border);border-radius:14px}.table{width:100%;border-collapse:collapse;min-width:700px}.table th,.table td{padding:10px;border-bottom:1px solid #eef2f7;text-align:right;white-space:nowrap}.table th{font-size:11px;color:#64748b;background:#f8fafc}.table td{font-size:12px}.muted{color:var(--muted)}.empty{padding:38px;text-align:center;color:var(--muted)}.error{padding:14px;background:#fff1f2;border:1px solid #fecdd3;border-radius:14px;color:#9f1239}.success{padding:14px;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:14px;color:#065f46}
.drawer{display:none;position:fixed;inset:0;background:rgba(15,23,42,.38);z-index:40}.drawer.open{display:block}.drawer-panel{position:absolute;right:0;top:0;bottom:0;width:min(92vw,370px);background:#fff;padding:16px;overflow:auto}.mobile-only{display:none}
@media(max-width:1050px){.grid-4{grid-template-columns:repeat(2,minmax(0,1fr))}.grid-3{grid-template-columns:repeat(2,minmax(0,1fr))}.sidebar{display:none}.main{margin-right:0}.mobile-only{display:block}}
@media(max-width:650px){.topbar{height:auto;min-height:66px;padding:10px 12px}.title{font-size:16px}.topbar-right .pill{display:none}.main{padding:12px}.grid-4,.grid-3,.grid-2{grid-template-columns:1fr}.card{padding:14px}.actions{width:100%}.actions .btn{flex:1}}
