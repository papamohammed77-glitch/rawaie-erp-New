        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        var map = {};
        for (var i = 0; i < details.length; i++) {
            var code = details[i].item_code || details[i].item_name;
            var name = details[i].item_name || code;
