async function openView(view){STATE.view=view;Array.prototype.forEach.call(byId('sidebar').querySelectorAll('.nav'),function(x){x.classList.toggle('active',x.getAttribute('data-view')===view)});if(!actions[view])return;try{await actions[view]()}catch(e){byId('content').innerHTML='<div class="notice bad">'+esc(e.message||e)+'</div>'}}
async function boot(authUser){clearError();try{await authoritativeContext(authUser);renderNav();showApp();byId('companyPill').textContent=(STATE.company&&STATE.company.name)||'الشركة';byId('userPill').textContent=STATE.user.name||STATE.user.email;online();await openView('dashboard')}catch(e){await client.auth.signOut();showLogin();setError(e.message||'فشل تهيئة الجلسة')}}
async function login(){clearError();var email=(byId('loginEmail').value||'').trim(),password=byId('loginPassword').value||'';if(!email||!password){setError('أدخل البريد وكلمة المرور');return}byId('loginButton').disabled=true;try{var r=await client.auth.signInWithPassword({email:email,password:password});if(r.error)throw r.error;await boot(r.data.user)}catch(e){setError(e.message||'فشل تسجيل الدخول')}finally{byId('loginButton').disabled=false}}
byId('loginButton').addEventListener('click',login);byId('loginPassword').addEventListener('keydown',function(e){if(e.key==='Enter')login()});byId('logoutButton').addEventListener('click',async function(){await client.auth.signOut();location.reload()});byId('menuButton').addEventListener('click',function(){byId('sidebar').classList.toggle('open')});window.addEventListener('online',online);window.addEventListener('offline',online);client.auth.onAuthStateChange(function(event,session){if(event==='SIGNED_OUT')showLogin();else if(event==='SIGNED_IN'&&session&&session.user)boot(session.user)});client.auth.getSession().then(function(r){if(r.data&&r.data.session)boot(r.data.session.user);else showLogin()}).catch(function(e){showLogin();setError(e.message||'فشل تهيئة الجلسة')});online();
})();
</script>
