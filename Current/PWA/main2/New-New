                var rsUuid = (newRsRes && newRsRes.data) ? newRsRes.data.id : json.rsId;
                for (var i = 0; i < ordersData.length; i++) {
                    if (selected.indexOf(ordersData[i].order_code) !== -1) {
                        ordersData[i].runsheet_id = rsUuid;
