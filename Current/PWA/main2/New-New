    function _printOrder(code) {
        showLoader('جاري تحضير الطباعة...');
        
        var order = null;
        var items = [];
        var settings = {};
        
        supabase.from('orders').select('*').eq('company_id', _rwCompanyId()).eq('order_code', code).maybeSingle()
            .then(function(oRes) {
                order = oRes.data;
                if (!order) throw new Error('ORDER_NOT_FOUND');
                return supabase.from('order_details').select('*').eq('order_id', order.id);
            })
            .then(function(itRes) {
                items = itRes.data || [];
                return supabase.from('app_settings').select('*').eq('company_id', _rwCompanyId()).order('created_at', { ascending: true }).limit(1).single();
            })
            .then(function(sRes) {
                if (sRes.data) settings = sRes.data;
                _buildPrintWindow(order, items, settings);
            })
            .catch(function(err) {
                console.error('Print error:', err);
                if (order) {
                    _buildPrintWindow(order, items, {});
                } else {
                    hideLoader();
                    showToast('الأوردر غير موجود', 'error');
                }
            });
    }
    
