newReceipt: function () {
    var s = this;

    Swal.fire({
        title: 'سند قبض جديد',
        html:
            '<div style="text-align:right">' +
            '<label style="display:block;margin:0 0 6px;font-weight:700">المبلغ</label>' +
            '<input id="rcptAmt" class="swal2-input" placeholder="المبلغ" type="number" min="0.01" step="0.01">' +

            '<label style="display:block;margin:10px 0 6px;font-weight:700">الحساب المقابل</label>' +
            '<select id="rcptOffsetAccount" class="swal2-select" style="width:90%;margin:0 auto 10px auto"></select>' +

            '<label style="display:block;margin:10px 0 6px;font-weight:700">المرجع</label>' +
            '<input id="rcptRef" class="swal2-input" placeholder="مرجع السند">' +

            '<label style="display:block;margin:10px 0 6px;font-weight:700">ملاحظات</label>' +
            '<textarea id="rcptNotes" class="swal2-textarea" placeholder="ملاحظات اختيارية"></textarea>' +
            '</div>',
        showCancelButton: true,
        confirmButtonText: 'حفظ سند القبض',
        cancelButtonText: 'إلغاء',
        allowOutsideClick: false,
        didOpen: function () {
            var select = document.getElementById('rcptOffsetAccount');

            if (!select) {
                return;
            }

            select.innerHTML = '<option value="">جاري تحميل الحسابات...</option>';

            supabase.auth.getSession()
                .then(function (sessionResult) {
                    var session = sessionResult && sessionResult.data
                        ? sessionResult.data.session
                        : null;

                    if (!session || !session.user) {
                        throw new Error('جلسة المستخدم غير صالحة');
                    }

                    return supabase
                        .from('users')
                        .select('company_id,status')
                        .eq('auth_id', session.user.id)
                        .single();
                })
                .then(function (userResult) {
                    if (userResult.error) {
                        throw userResult.error;
                    }

                    var companyId = userResult.data && userResult.data.company_id;

                    if (!companyId) {
                        throw new Error('تعذر تحديد الشركة الحالية');
                    }

                    return supabase
                        .from('chart_of_accounts')
                        .select('id,account_code,account_name,account_type,normal_balance')
                        .eq('company_id', companyId)
                        .eq('is_active', true)
                        .order('account_code', { ascending: true });
                })
                .then(function (accountsResult) {
                    if (accountsResult.error) {
                        throw accountsResult.error;
                    }

                    var accounts = accountsResult.data || [];

                    if (!accounts.length) {
                        throw new Error('لا توجد حسابات محاسبية فعالة متاحة');
                    }

                    var options = '<option value="">اختر الحساب المقابل</option>';

                    for (var i = 0; i < accounts.length; i++) {
                        var account = accounts[i];

                        options +=
                            '<option value="' + String(account.id).replace(/"/g, '&quot;') + '">' +
                            String(account.account_code || '') +
                            ' — ' +
                            String(account.account_name || '') +
                            '</option>';
                    }

                    select.innerHTML = options;
                })
                .catch(function (error) {
                    select.innerHTML = '<option value="">تعذر تحميل الحسابات</option>';

                    Swal.showValidationMessage(
                        error && error.message
                            ? error.message
                            : 'تعذر تحميل الحسابات المحاسبية'
                    );
                });
        },
        preConfirm: function () {
            var amount = Number(document.getElementById('rcptAmt').value);
            var offsetAccountId = document.getElementById('rcptOffsetAccount').value;
            var reference = document.getElementById('rcptRef').value.trim();
            var notes = document.getElementById('rcptNotes').value.trim();

            if (!(amount > 0)) {
                Swal.showValidationMessage('أدخل مبلغ قبض صحيح');
                return false;
            }

            if (!offsetAccountId) {
                Swal.showValidationMessage('اختر الحساب المقابل');
                return false;
            }

            return {
                amount: amount,
                offsetAccountId: offsetAccountId,
                reference: reference,
                notes: notes
            };
        }
    }).then(function (result) {
        if (!result.isConfirmed || !result.value) {
            return;
        }

        RW_UI.showLoader('جاري حفظ سند القبض...');

        supabase.auth.getSession()
            .then(function (sessionResult) {
                var session = sessionResult && sessionResult.data
                    ? sessionResult.data.session
                    : null;

                if (!session || !session.access_token) {
                    throw new Error('جلسة المستخدم غير صالحة');
                }

                return supabase
                    .from('users')
                    .select('company_id,status')
                    .eq('auth_id', session.user.id)
                    .single()
                    .then(function (userResult) {
                        if (userResult.error) {
                            throw userResult.error;
                        }

                        var companyId = userResult.data && userResult.data.company_id;

                        if (!companyId) {
                            throw new Error('تعذر تحديد الشركة الحالية');
                        }

                        return supabase
                            .from('treasury')
                            .select('id,account_code,current_balance')
                            .eq('company_id', companyId)
                            .eq('is_active', true)
                            .single();
                    })
                    .then(function (treasuryResult) {
                        if (treasuryResult.error) {
                            throw treasuryResult.error;
                        }

                        var treasury = treasuryResult.data;

                        return supabase
                            .from('chart_of_accounts')
                            .select('id,account_code,account_name')
                            .eq('company_id', session.user.user_metadata && session.user.user_metadata.company_id
                                ? session.user.user_metadata.company_id
                                : undefined)
                            .eq('account_code', '121')
                            .eq('is_active', true)
                            .single()
                            .then(function (cashAccountResult) {
                                if (cashAccountResult.error) {
                                    /*
                                     * The current Production master uses 121 as
                                     * the canonical cash account. If user metadata
                                     * does not contain company_id, fall back to the
                                     * authenticated user's public.users company.
                                     */
                                    return supabase
                                        .from('users')
                                        .select('company_id')
                                        .eq('auth_id', session.user.id)
                                        .single()
                                        .then(function (userResult) {
                                            if (userResult.error) {
                                                throw userResult.error;
                                            }

                                            return supabase
                                                .from('chart_of_accounts')
                                                .select('id,account_code,account_name')
                                                .eq('company_id', userResult.data.company_id)
                                                .eq('account_code', '121')
                                                .eq('is_active', true)
                                                .single();
                                        });
                                }

                                return cashAccountResult;
                            })
                            .then(function (cashAccountResult) {
                                if (cashAccountResult.error) {
                                    throw cashAccountResult.error;
                                }

                                return {
                                    treasury: treasury,
                                    cashAccount: cashAccountResult.data
                                };
                            });
                    });
            })
            .then(function (context) {
                var operationId = crypto.randomUUID();

                return supabase.auth.getSession().then(function (sessionResult) {
                    var session = sessionResult && sessionResult.data
                        ? sessionResult.data.session
                        : null;

                    if (!session || !session.access_token) {
                        throw new Error('جلسة المستخدم غير صالحة');
                    }

                    return fetch(
                        SUPABASE_URL + '/functions/v1/save-receipt-voucher',
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': 'Bearer ' + session.access_token
                            },
                            body: JSON.stringify({
                                header: {
                                    operationId: operationId,
                                    treasuryId: context.treasury.id,
                                    cashAccountId: context.cashAccount.id,
                                    offsetAccountId: result.value.offsetAccountId,
                                    date: new Date().toISOString().split('T')[0],
                                    reference: result.value.reference || null,
                                    mainAccountName: null,
                                    notes: result.value.notes || '',
                                    voucherCode: null
                                },
                                lines: [
                                    {
                                        amount: result.value.amount,
                                        description: result.value.notes || 'سند قبض'
                                    }
                                ]
                            })
                        }
                    );
                });
            })
            .then(function (response) {
                return response.json().then(function (payload) {
                    if (!response.ok || !payload || payload.success === false) {
                        throw new Error(
                            payload && (payload.error || payload.msg)
                                ? (payload.error || payload.msg)
                                : 'فشل حفظ سند القبض'
                        );
                    }

                    return payload;
                });
            })
            .then(function (payload) {
                RW_UI.hideLoader();
                RW_UI.toast(
                    payload.refNumber || payload.entry_code || 'تم حفظ سند القبض',
                    'success'
                );
                s.renderReceipts();
            })
            .catch(function (error) {
                RW_UI.hideLoader();
                RW_UI.showError(
                    error && error.message
                        ? error.message
                        : 'تعذر حفظ سند القبض'
                );
            });
    });
},
