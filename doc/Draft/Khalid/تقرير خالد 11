            var offsetAccountId = document.getElementById('pmtOffsetAccount').value;
            var reference = document.getElementById('pmtRef').value.trim();
            var notes = document.getElementById('pmtNotes').value.trim();

            if (!(amount > 0)) {
                Swal.showValidationMessage('أدخل مبلغ صرف صحيح');
                return false;
            }

            if (!offsetAccountId) {
                Swal.showValidationMessage('اختر الحساب المقابل');
                return false;
            }

            return {
                amount: amount,
                offsetAccountId: offsetAccountId,
                reference: reference,
                notes: notes
            };
        }
    }).then(function (result) {
        if (!result.isConfirmed || !result.value) {
            return;
        }

        RW_UI.showLoader('جاري حفظ سند الصرف...');

        supabase.auth.getSession()
            .then(function (sessionResult) {
                var session = sessionResult && sessionResult.data
                    ? sessionResult.data.session
                    : null;

                if (!session || !session.access_token) {
                    throw new Error('جلسة المستخدم غير صالحة');
                }

                return supabase
                    .from('users')
                    .select('company_id,status')
                    .eq('auth_id', session.user.id)
                    .single()
                    .then(function (userResult) {
                        if (userResult.error) {
                            throw userResult.error;
                        }

                        var companyId = userResult.data && userResult.data.company_id;

                        if (!companyId) {
                            throw new Error('تعذر تحديد الشركة الحالية');
                        }

                        return supabase
                            .from('treasury')
                            .select('id,account_code,current_balance')
                            .eq('company_id', companyId)
                            .eq('is_active', true)
                            .single()
                            .then(function (treasuryResult) {
                                if (treasuryResult.error) {
                                    throw treasuryResult.error;
                                }

                                return supabase
                                    .from('chart_of_accounts')
                                    .select('id,account_code,account_name')
                                    .eq('company_id', companyId)
                                    .eq('account_code', '121')
                                    .eq('is_active', true)
                                    .single()
                                    .then(function (cashAccountResult) {
                                        if (cashAccountResult.error) {
                                            throw cashAccountResult.error;
                                        }

                                        return {
                                            treasury: treasuryResult.data,
                                            cashAccount: cashAccountResult.data
                                        };
                                    });
                            });
                    });
            })
            .then(function (context) {
                var operationId = crypto.randomUUID();

                return supabase.auth.getSession().then(function (sessionResult) {
                    var session = sessionResult && sessionResult.data
                        ? sessionResult.data.session
                        : null;

                    if (!session || !session.access_token) {
                        throw new Error('جلسة المستخدم غير صالحة');
                    }

                    return fetch(
                        SUPABASE_URL + '/functions/v1/save-payment-voucher',
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': 'Bearer ' + session.access_token
                            },
                            body: JSON.stringify({
                                header: {
                                    operationId: operationId,
                                    treasuryId: context.treasury.id,
                                    cashAccountId: context.cashAccount.id,
                                    offsetAccountId: result.value.offsetAccountId,
                                    date: new Date().toISOString().split('T')[0],
                                    reference: result.value.reference || null,
                                    mainAccountName: null,
                                    notes: result.value.notes || '',
                                    voucherCode: null
                                },
                                lines: [
                                    {
                                        amount: result.value.amount,
                                        description: result.value.notes || 'سند صرف'
                                    }
                                ]
                            })
                        }
                    );
                });
            })
            .then(function (response) {
                return response.json().then(function (payload) {
                    if (!response.ok || !payload || payload.success === false) {
                        throw new Error(
                            payload && (payload.error || payload.msg)
                                ? (payload.error || payload.msg)
                                : 'فشل حفظ سند الصرف'
                        );
                    }

                    return payload;
                });
            })
            .then(function (payload) {
                RW_UI.hideLoader();
                RW_UI.toast(
                    payload.refNumber || payload.entry_code || 'تم حفظ سند الصرف',
                    'success'
                );
                s.renderPayments();
            })
            .catch(function (error) {
                RW_UI.hideLoader();
                RW_UI.showError(
                    error && error.message
                        ? error.message
                        : 'تعذر حفظ سند الصرف'
                );
            });
    });
},
ملاحظة مهمة جدًا قبل اللصق

هذه الدوال لا تفترض الحساب المقابل.

بدل أن تستمر في تحويل حقل المرجع إلى حساب محاسبي — وهو الخطأ الموجود في التطبيق الحالي — تعرض الحسابات الـ17 الفعلية من Production ليختار المحاسب الحساب المقابل، بينما حساب النقدية 121 يتم حله من الـCOA نفسها، وtreasuryId يُحل من Treasury الحالية.

هذا ضروري لأن Production الحالية لا تعطي أي دليل أن كل سند قبض يقابل حسابًا واحدًا ثابتًا، ولا أن كل سند صرف يقابل حساب 5 كما كان الكود القديم يوحي.

إذن المطلوب منك الآن

في Current/PWA/accountant.html فقط:

احذف:

App.newReceipt()

واستبدلها بالدالة الأولى أعلاه.

ثم احذف:

App.newPayment()

واستبدلها بالدالة الثانية أعلاه.

ولا تعدل أي دالة أخرى.

والسبب في عدم إرسال renderDashboard() أو renderReceipts() أو renderPayments() هو أن المطلوب الحالي هو إغلاق Consumer Write Contract فقط، وليس إعادة تصميم التطبيق كله.

كما أن النسخة المنشورة الحالية من accountant.html تؤكد أن المشكلة محصورة فعليًا في هاتين الدالتين؛ الكود الحالي ينادي الـEdge القديم بالـpayload القديم.

خالد لم يغلق Phase 3/4 بعد؛ لكنه نقل الـbackend المالي إلى Production الحالية، وأصبح المطلوب التالي هو لصق هاتين الدالتين ثم إجراء authenticated HTTP + retry + runtime verification قبل إعلان Consumer closure.
