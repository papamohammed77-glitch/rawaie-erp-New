واستبدلها بالدالة التالية كاملة:

newReceipt: function () {
    var s = this;

    Swal.fire({
        title: 'سند قبض جديد',
        html:
            '<div style="text-align:right">' +
                '<label style="display:block;margin:0 0 6px;font-weight:700">المبلغ</label>' +
                '<input id="rcptAmt" class="swal2-input" placeholder="المبلغ" type="number" min="0.01" step="0.01">' +

                '<label style="display:block;margin:10px 0 6px;font-weight:700">الحساب المقابل</label>' +
                '<select id="rcptOffsetAccount" class="swal2-select" style="width:90%;margin:0 auto 10px auto"></select>' +

                '<label style="display:block;margin:10px 0 6px;font-weight:700">المرجع</label>' +
                '<input id="rcptRef" class="swal2-input" placeholder="مرجع السند">' +

                '<label style="display:block;margin:10px 0 6px;font-weight:700">ملاحظات</label>' +
                '<textarea id="rcptNotes" class="swal2-textarea" placeholder="ملاحظات اختيارية"></textarea>' +
            '</div>',
        showCancelButton: true,
        confirmButtonText: 'حفظ سند القبض',
        cancelButtonText: 'إلغاء',
        allowOutsideClick: false,

        didOpen: function () {
            var select = document.getElementById('rcptOffsetAccount');

            if (!select) {
                return;
            }

            select.innerHTML = '<option value="">جاري تحميل الحسابات...</option>';

            supabase.auth.getUser()
                .then(function (authResult) {
                    if (authResult.error || !authResult.data || !authResult.data.user) {
                        throw new Error('INVALID_SESSION');
                    }

                    return supabase
                        .from('users')
                        .select('company_id,status')
                        .eq('auth_id', authResult.data.user.id)
                        .maybeSingle();
                })
                .then(function (userResult) {
                    if (
                        userResult.error ||
                        !userResult.data ||
                        !userResult.data.company_id ||
                        (
                            userResult.data.status &&
                            userResult.data.status !== 'Active'
                        )
                    ) {
                        throw new Error('INVALID_COMPANY_CONTEXT');
                    }

                    return supabase
                        .from('chart_of_accounts')
                        .select(
                            'id,account_code,account_name,account_type,normal_balance'
                        )
                        .eq('company_id', userResult.data.company_id)
                        .eq('is_active', true)
                        .order('account_code', { ascending: true });
                })
                .then(function (accountsResult) {
                    if (accountsResult.error) {
                        throw accountsResult.error;
                    }

                    var accounts = accountsResult.data || [];

                    if (!accounts.length) {
                        throw new Error('NO_ACTIVE_ACCOUNTS_AVAILABLE');
                    }

                    var options = '<option value="">اختر الحساب المقابل</option>';

                    for (var i = 0; i < accounts.length; i++) {
                        var account = accounts[i];

                        options +=
                            '<option value="' +
                            String(account.id).replace(/"/g, '&quot;') +
                            '">' +
                            String(account.account_code || '') +
                            ' — ' +
                            String(account.account_name || '') +
                            '</option>';
                    }

                    select.innerHTML = options;
                })
                .catch(function (error) {
                    select.innerHTML =
                        '<option value="">تعذر تحميل الحسابات</option>';

                    Swal.showValidationMessage(
                        error && error.message
                            ? error.message
                            : 'تعذر تحميل الحسابات المحاسبية'
                    );
                });
        },

        preConfirm: function () {
            var amount = Number(
                document.getElementById('rcptAmt').value
            );

            var offsetAccountId =
                document.getElementById('rcptOffsetAccount').value;

            var reference =
                document.getElementById('rcptRef').value.trim();

            var notes =
                document.getElementById('rcptNotes').value.trim();

            if (!(amount > 0)) {
                Swal.showValidationMessage(
                    'أدخل مبلغ قبض صحيح'
                );
                return false;
            }

            if (!offsetAccountId) {
                Swal.showValidationMessage(
                    'اختر الحساب المقابل'
                );
                return false;
            }

            return {
                amount: amount,
                offsetAccountId: offsetAccountId,
                reference: reference,
                notes: notes
            };
        }
    })
    .then(function (result) {
        if (!result.isConfirmed || !result.value) {
            return;
        }

        RW_UI.showLoader('جاري حفظ سند القبض...');

        return supabase.auth.getUser()
            .then(function (authResult) {
                if (
                    authResult.error ||
                    !authResult.data ||
                    !authResult.data.user
                ) {
                    throw new Error('INVALID_SESSION');
                }

                var user = authResult.data.user;

                return supabase
                    .from('users')
                    .select('company_id,status')
                    .eq('auth_id', user.id)
                    .maybeSingle()
                    .then(function (userResult) {
                        if (
                            userResult.error ||
                            !userResult.data ||
                            !userResult.data.company_id ||
                            (
                                userResult.data.status &&
                                userResult.data.status !== 'Active'
                            )
                        ) {
                            throw new Error('INVALID_COMPANY_CONTEXT');
                        }

                        var companyId =
                            userResult.data.company_id;

                        return Promise.all([
                            Promise.resolve(user),

                            supabase
                                .from('treasury')
                                .select(
                                    'id,account_code,current_balance'
                                )
                                .eq('company_id', companyId)
                                .eq('is_active', true)
                                .maybeSingle(),

                            supabase
                                .from('chart_of_accounts')
                                .select(
                                    'id,account_code,account_name'
                                )
                                .eq('company_id', companyId)
                                .eq('account_code', '121')
                                .eq('is_active', true)
                                .maybeSingle()
                        ]);
                    });
            })
            .then(function (results) {
                var user = results[0];
                var treasuryResult = results[1];
                var cashAccountResult = results[2];

                if (treasuryResult.error) {
                    throw treasuryResult.error;
                }

                if (
                    !treasuryResult.data ||
                    !treasuryResult.data.id
                ) {
                    throw new Error(
                        'RECEIPT_TREASURY_MAPPING_REQUIRED'
                    );
                }

                if (cashAccountResult.error) {
                    throw cashAccountResult.error;
                }

                if (
                    !cashAccountResult.data ||
                    !cashAccountResult.data.id
                ) {
                    throw new Error(
                        'CASH_ACCOUNT_121_NOT_CONFIGURED'
                    );
                }

                return supabase
                    .auth
                    .getSession()
                    .then(function (sessionResult) {
                        if (
                            sessionResult.error ||
                            !sessionResult.data ||
                            !sessionResult.data.session ||
                            !sessionResult.data.session.access_token
                        ) {
                            throw new Error('INVALID_SESSION');
                        }

                        var operationId =
                            crypto.randomUUID();

                        return fetch(
                            SUPABASE_URL +
                            '/functions/v1/save-receipt-voucher',
                            {
                                method: 'POST',

                                headers: {
                                    'Content-Type':
                                        'application/json',

                                    'Authorization':
                                        'Bearer ' +
                                        sessionResult.data.session.access_token
                                },

                                body: JSON.stringify({
                                    header: {
                                        operationId:
                                            operationId,

                                        treasuryId:
                                            treasuryResult.data.id,

                                        cashAccountId:
                                            cashAccountResult.data.id,

                                        offsetAccountId:
                                            result.value.offsetAccountId,

                                        date:
                                            new Date()
                                                .toISOString()
                                                .split('T')[0],

                                        reference:
                                            result.value.reference ||
                                            null,

                                        notes:
                                            result.value.notes ||
                                            '',

                                        voucherCode:
                                            null
                                    },

                                    lines: [
                                        {
                                            amount:
                                                result.value.amount,

                                            description:
                                                result.value.notes ||
                                                'سند قبض'
                                        }
                                    ]
                                })
                            }
                        );
                    });
            })
            .then(function (response) {
                return response.json()
                    .then(function (payload) {
                        if (
                            !response.ok ||
                            !payload ||
                            payload.success === false
                        ) {
                            throw new Error(
                                payload &&
                                (payload.error || payload.msg)
                                    ? (
                                        payload.error ||
                                        payload.msg
                                    )
                                    : 'فشل حفظ سند القبض'
                            );
                        }

                        return payload;
                    });
            })
            .then(function (payload) {
                RW_UI.hideLoader();

                RW_UI.toast(
                    payload.refNumber ||
                    payload.entry_code ||
                    'تم حفظ سند القبض',
                    'success'
                );

                s.renderReceipts();
            })
            .catch(function (error) {
                RW_UI.hideLoader();

                RW_UI.showError(
                    error && error.message
                        ? error.message
                        : 'تعذر حفظ سند القبض'
                );
            });
    });
},
