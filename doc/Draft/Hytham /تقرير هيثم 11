            if (!Number.isFinite(amount) || amount <= 0) {
                Swal.showValidationMessage('أدخل مبلغًا صحيحًا أكبر من صفر');
                return false;
            }

            if (!offsetCode) {
                Swal.showValidationMessage('كود الحساب المقابل مطلوب');
                return false;
            }

            try {
                var accountResult = await supabase
                    .from('chart_of_accounts')
                    .select('id,account_code,account_name,is_active')
                    .eq('account_code', offsetCode)
                    .eq('is_active', true)
                    .maybeSingle();

                if (accountResult.error) {
                    throw new Error(accountResult.error.message);
                }

                if (!accountResult.data) {
                    Swal.showValidationMessage('الحساب المقابل غير موجود أو غير نشط: ' + offsetCode);
                    return false;
                }

                return {
                    amount: amount,
                    offsetAccountId: accountResult.data.id,
                    offsetAccountCode: accountResult.data.account_code,
                    offsetAccountName: accountResult.data.account_name,
                    reference: reference
                };

            } catch (err) {
                Swal.showValidationMessage(
                    'تعذر التحقق من الحساب: ' + (err && err.message ? err.message : 'خطأ غير معروف')
                );
                return false;
            }
        }
    }).then(function (result) {

        if (!result.isConfirmed || !result.value) {
            return;
        }

        var data = result.value;

        Swal.fire({
            title: 'جاري الحفظ...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: function () {
                Swal.showLoading();
            }
        });

        supabase.auth.getSession()
            .then(function (sessionResult) {

                var session = sessionResult &&
                              sessionResult.data &&
                              sessionResult.data.session;

                if (!session || !session.access_token) {
                    throw new Error('جلسة المستخدم غير صالحة');
                }

                var operationId =
                    (window.crypto && typeof window.crypto.randomUUID === 'function')
                        ? window.crypto.randomUUID()
                        : (
                            'PMT-' +
                            Date.now() +
                            '-' +
                            Math.random().toString(36).slice(2, 10)
                        );

                return fetch(
                    SUPABASE_URL + '/functions/v1/save-payment-voucher',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': 'Bearer ' + session.access_token
                        },
                        body: JSON.stringify({
                            header: {
                                operationId: operationId,
                                date: new Date().toISOString().slice(0, 10),
                                reference: data.reference || null,
                                notes: 'سند صرف',
                                cashAccountId: null,
                                offsetAccountId: data.offsetAccountId,
                                mainAccountName: data.offsetAccountName
                            },
                            lines: [
                                {
                                    accountName: data.offsetAccountName,
                                    accountCode: data.offsetAccountCode,
                                    description: data.reference || 'سند صرف',
                                    amount: data.amount
                                }
                            ]
                        })
                    }
                );
            })
            .then(async function (response) {

                var payload = await response.json().catch(function () {
                    return {
                        success: false,
                        error: 'استجابة غير صالحة من الخادم'
                    };
                });

                if (!response.ok || payload.success === false) {
                    throw new Error(
                        payload.error ||
                        payload.msg ||
                        'فشل حفظ سند الصرف'
                    );
                }

                return payload;
            })
            .then(function (payload) {

                Swal.close();

                RW_UI.toast(
                    payload.duplicate
                        ? 'العملية موجودة بالفعل ولم تتم إضافة حركة ثانية'
                        : 'تم حفظ سند الصرف بنجاح',
                    'success'
                );

                s.renderPayments();
            })
            .catch(function (err) {

                Swal.close();

                RW_UI.toast(
                    err && err.message
                        ? err.message
                        : 'فشل حفظ سند الصرف',
                    'error'
                );
            });
    });
},
نقطة مهمة حول الحساب المقابل

لم أُبقِ:

mainAccountName: r.value.ref

لأن هذا كان يخلط بين المرجع والحساب المحاسبي.

النسخة الجديدة تفصل بوضوح:

reference
      ≠
offsetAccountId
      ≠
offsetAccountName

وهذا يتوافق مع الـcanonical financial adapter الموجود حاليًا.

ما لا أنصح بتعديله الآن

لا أريد أن أجعلك تمسح دوالًا أخرى في الـPWA اعتمادًا على التخمين. في هذه الجولة الدليل المباشر يثبت أن newReceipt وnewPayment هما الدالتان اللتان لديهما Consumer Contract قديم واضح. أما receive-stock-voucher الحالي فقد تمت مراجعته ووجدناه بالفعل يستخدم operation_id وCore RPC بصورة صحيحة، لذلك لا نبدله بلا دليل جديد.

بعد لصق الدالتين، الخطوة الصحيحة هي اختبار Accountant PWA → Edge → Core → Journal/Cash → duplicate retry قبل لمس أي PWA آخر.
