newReceipt: function () {
    var s = this;

    Swal.fire({
        title: 'سند قبض جديد',
        html:
            '<div style="text-align:right">' +
                '<label style="display:block;margin-bottom:6px;font-weight:bold">المبلغ</label>' +
                '<input id="rcptAmt" class="swal2-input" placeholder="المبلغ" type="number" min="0.01" step="0.01">' +

                '<label style="display:block;margin:12px 0 6px;font-weight:bold">كود الحساب المقابل</label>' +
                '<input id="rcptOffsetCode" class="swal2-input" placeholder="مثال: 123" value="123">' +

                '<label style="display:block;margin:12px 0 6px;font-weight:bold">المرجع</label>' +
                '<input id="rcptRef" class="swal2-input" placeholder="المرجع">' +
            '</div>',
        showCancelButton: true,
        confirmButtonText: 'حفظ',
        cancelButtonText: 'إلغاء',
        focusConfirm: false,

        preConfirm: async function () {
            var amount = Number(document.getElementById('rcptAmt').value);
            var offsetCode = String(document.getElementById('rcptOffsetCode').value || '').trim();
            var reference = String(document.getElementById('rcptRef').value || '').trim();

            if (!Number.isFinite(amount) || amount <= 0) {
                Swal.showValidationMessage('أدخل مبلغًا صحيحًا أكبر من صفر');
                return false;
            }

            if (!offsetCode) {
                Swal.showValidationMessage('كود الحساب المقابل مطلوب');
                return false;
            }

            try {
                var accountResult = await supabase
                    .from('chart_of_accounts')
                    .select('id,account_code,account_name,is_active')
                    .eq('account_code', offsetCode)
                    .eq('is_active', true)
                    .maybeSingle();

                if (accountResult.error) {
                    throw new Error(accountResult.error.message);
                }

                if (!accountResult.data) {
                    Swal.showValidationMessage('الحساب المقابل غير موجود أو غير نشط: ' + offsetCode);
                    return false;
                }

                return {
                    amount: amount,
                    offsetAccountId: accountResult.data.id,
                    offsetAccountCode: accountResult.data.account_code,
                    offsetAccountName: accountResult.data.account_name,
                    reference: reference
                };

            } catch (err) {
                Swal.showValidationMessage(
                    'تعذر التحقق من الحساب: ' + (err && err.message ? err.message : 'خطأ غير معروف')
                );
                return false;
            }
        }
    }).then(function (result) {

        if (!result.isConfirmed || !result.value) {
            return;
        }

        var data = result.value;

        Swal.fire({
            title: 'جاري الحفظ...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: function () {
                Swal.showLoading();
            }
        });

        supabase.auth.getSession()
            .then(function (sessionResult) {

                var session = sessionResult &&
                              sessionResult.data &&
                              sessionResult.data.session;

                if (!session || !session.access_token) {
                    throw new Error('جلسة المستخدم غير صالحة');
                }

                var operationId =
                    (window.crypto && typeof window.crypto.randomUUID === 'function')
                        ? window.crypto.randomUUID()
                        : (
                            'RCV-' +
                            Date.now() +
                            '-' +
                            Math.random().toString(36).slice(2, 10)
                        );

                return fetch(
                    SUPABASE_URL + '/functions/v1/save-receipt-voucher',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': 'Bearer ' + session.access_token
                        },
                        body: JSON.stringify({
                            header: {
                                operationId: operationId,
                                date: new Date().toISOString().slice(0, 10),
                                reference: data.reference || null,
                                notes: 'سند قبض',
                                cashAccountId: null,
                                offsetAccountId: data.offsetAccountId,
                                mainAccountName: data.offsetAccountName
                            },
                            lines: [
                                {
                                    accountName: data.offsetAccountName,
                                    accountCode: data.offsetAccountCode,
                                    description: data.reference || 'سند قبض',
                                    amount: data.amount
                                }
                            ]
                        })
                    }
                );
            })
            .then(async function (response) {

                var payload = await response.json().catch(function () {
                    return {
                        success: false,
                        error: 'استجابة غير صالحة من الخادم'
                    };
                });

                if (!response.ok || payload.success === false) {
                    throw new Error(
                        payload.error ||
                        payload.msg ||
                        'فشل حفظ سند القبض'
                    );
                }

                return payload;
            })
            .then(function (payload) {

                Swal.close();

                RW_UI.toast(
                    payload.duplicate
                        ? 'العملية موجودة بالفعل ولم تتم إضافة حركة ثانية'
                        : 'تم حفظ سند القبض بنجاح',
                    'success'
                );

                s.renderReceipts();
            })
            .catch(function (err) {

                Swal.close();

                RW_UI.toast(
                    err && err.message
                        ? err.message
                        : 'فشل حفظ سند القبض',
                    'error'
                );
            });
    });
},
