4. التعديل الرابع — onSearchInput

احذف الدالة الحالية كاملة:

onSearchInput: function(query){
    ...
},

واستبدلها بـ:

onSearchInput: function(query){
    var self = this;


    if(this.searchTimer) clearTimeout(this.searchTimer);


    if(!query || query.trim().length < 1){
        byId('searchDropdown').classList.add('hidden');
        return;
    }


    if(!this.companyId){
        byId('searchDropdown').classList.add('hidden');
        return;
    }


    this.searchTimer = setTimeout(function(){


        supabase
            .from('runsheets')
            .select('runsheet_code, status, run_date, picker_id, run_sheet_details(count)')
            .eq('company_id', self.companyId)
            .ilike('runsheet_code', '%' + query.trim() + '%')
            .limit(10)
            .then(function(res){


                if(res.error){
                    throw res.error;
                }


                self.searchResults = res.data || [];
                self.renderSearchDropdown();
            })
            .catch(function(err){
                console.error('Runsheet search error:', err);
                self.searchResults = [];
                self.renderSearchDropdown();
            });


    }, 300);
},

