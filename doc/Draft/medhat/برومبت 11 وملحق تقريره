            cancelButton: '!rounded-xl'
        }
    }).then(function(result) {


        if (!result.isConfirmed) return;


        /*
         * نفس operation_id يجب أن يبقى ثابتًا أثناء إعادة إرسال
         * نفس عملية الإنهاء.
         *
         * sessionStorage يحافظ عليه حتى مع reload داخل نفس التبويب.
         */
