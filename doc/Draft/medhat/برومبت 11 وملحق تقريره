completePicking: function() {
    var self = this;


    if (!this.session) return;


    if (!navigator.onLine) {
        toast('أنت غير متصل', 'warning');
        return;
    }


    var items = [];
    var fullCount = 0, partialCount = 0, zeroCount = 0;


    for (var i = 0; i < this.session.items.length; i++) {
        var it = this.session.items[i];


        items.push({
            itemCode: it.item_code,
            pickedQty: it.qty_picked,
            notes: it.notes
        });


        if (it.qty_picked >= it.qty_ordered) {
            fullCount++;
        } else if (it.qty_picked > 0) {
            partialCount++;
        } else {
            zeroCount++;
        }
    }


    var summaryHtml =
        '<div class="text-right text-sm">' +
        '<p>أنت على وشك إنهاء تحضير الرانشيت <strong>' +
        this.session.runsheet_code +
        '</strong>.</p>' +
        '<div class="mt-3 space-y-1">' +
        '<div>✅ <strong>' + fullCount + '</strong> أصناف مكتملة</div>' +
        '<div>⚠️ <strong>' + partialCount + '</strong> أصناف منقوصة</div>' +
        '<div>❌ <strong>' + zeroCount + '</strong> أصناف لم تُحضّر</div>' +
        '</div>';


    if (partialCount > 0 || zeroCount > 0) {
        summaryHtml +=
            '<hr class="my-3">' +
            '<p class="text-amber-600 font-bold text-xs">الأصناف الناقصة:</p>' +
            '<ul class="text-xs space-y-1 mt-1">';


        for (var k = 0; k < this.session.items.length; k++) {
            var item = this.session.items[k];


            if (item.qty_picked < item.qty_ordered) {
                summaryHtml +=
                    '<li>• ' +
                    item.item_name +
                    ' (' +
                    item.qty_picked +
                    '/' +
                    item.qty_ordered +
                    ') ' +
                    (item.notes
                        ? '– ' + item.notes
                        : '<span class="text-red-400">بدون سبب</span>') +
                    '</li>';
            }
        }


        summaryHtml += '</ul>';
    }


    summaryHtml += '</div>';


    Swal.fire({
        title: 'تأكيد إنهاء التحضير',
        html: summaryHtml,
