async function saveReceipt() {
    const { user, companyId } = await resolveFinancialContext();
    const treasury = await resolveActiveTreasury(companyId);
    const cashAccount = await resolveCashAccount(companyId);

    const offsetAccountId =
        document.getElementById("rcpt-offset-account")?.value;

    if (!offsetAccountId) {
        throw new Error("RECEIPT_OFFSET_ACCOUNT_REQUIRED");
    }

    const operationId =
        document.getElementById("rcpt-operation-id")?.value ||
        crypto.randomUUID();

    const lines = collectReceiptLines();

    if (!lines.length) {
        throw new Error("RECEIPT_LINES_REQUIRED");
    }

    const result = await supabase.functions.invoke(
        "save-receipt-voucher",
        {
            body: {
                header: {
                    operationId,
                    treasuryId: treasury.id,
                    cashAccountId: cashAccount.id,
                    offsetAccountId,
                    date: document.getElementById("rcpt-date").value,
                    reference:
                        document.getElementById("rcpt-reference")?.value || null,
                    notes:
                        document.getElementById("rcpt-notes")?.value || null
                },
                lines
            }
        }
    );

    if (result.error) {
        throw result.error;
    }

    return result.data;
}

