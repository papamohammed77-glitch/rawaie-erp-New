    function _recalcReceiptTotal() {
        var total = 0;
        var count = 0;

        document.querySelectorAll('.rcpt-line').forEach(function(line) {
            var account = line.querySelector('.rcpt-line-account');
            var amount = line.querySelector('.rcpt-line-amount');

            if (account && account.value) count++;

            total += Number(amount ? amount.value : 0) || 0;
        });

        safeText(byId('rcpt-total'), _fmtNum(total));
        safeText(byId('rcpt-count'), String(count));

        var treasuryId = byId('rcpt-cashbox')
            ? byId('rcpt-cashbox').value
            : '';

        var status = byId('rcpt-balance-status');

        if (!status) return;

        if (!treasuryId) {
            safeText(status, 'اختر الخزينة');
            status.className = 'font-black text-blue-700';
            return;
        }

        var treasury = null;

        for (var i = 0; i < _cache.treasury.length; i++) {
            if (_cache.treasury[i].id === treasuryId) {
                treasury = _cache.treasury[i];
                break;
            }
        }

        if (!treasury) {
            safeText(status, 'الخزينة غير متاحة');
            status.className = 'font-black text-red-700';
            return;
        }

        var balance = Number(treasury.current_balance || 0);

        safeText(
            status,
            'الرصيد الحالي: ' + _fmtNum(balance) +
            ' | بعد القبض: ' + _fmtNum(balance + total)
        );

        status.className = 'font-black text-emerald-700';
    }

    async function _saveReceipt() {
        var host = byId('finance-content');

        if (!host || host.dataset.revenueSaving === '1') return;

        var date = byId('rcpt-date')
            ? byId('rcpt-date').value
            : '';

        var branchId = byId('rcpt-branch')
            ? byId('rcpt-branch').value
            : '';

        var treasuryId = byId('rcpt-cashbox')
            ? byId('rcpt-cashbox').value
            : '';

        var categoryId = byId('rcpt-category')
            ? byId('rcpt-category').value
            : '';

        var payerName = byId('rcpt-payer')
            ? byId('rcpt-payer').value.trim()
            : '';

        var reference = byId('rcpt-reference')
            ? byId('rcpt-reference').value.trim()
            : '';

        var description = byId('rcpt-notes')
            ? byId('rcpt-notes').value.trim()
            : '';

        var lines = [];

        document.querySelectorAll('.rcpt-line').forEach(function(line) {
            var accountId = line.querySelector('.rcpt-line-account')
                ? line.querySelector('.rcpt-line-account').value
                : '';

            var costCenterId = line.querySelector('.rcpt-line-cost-center')
                ? line.querySelector('.rcpt-line-cost-center').value
                : '';

            var lineDescription = line.querySelector('.rcpt-line-desc')
                ? line.querySelector('.rcpt-line-desc').value.trim()
                : '';

            var amount = line.querySelector('.rcpt-line-amount')
                ? Number(line.querySelector('.rcpt-line-amount').value)
                : 0;

            if (accountId && Number.isFinite(amount) && amount > 0) {
                lines.push({
                    account_id: accountId,
                    cost_center_id: costCenterId || null,
                    tax_code_id: null,
                    description: lineDescription || description || 'إيراد',
                    amount: amount,
                    tax_amount: 0
                });
            }
        });

        if (!date) {
            _showToast('حدد تاريخ الإيراد', 'warning');
            return;
        }

        if (!branchId) {
            _showToast('اختر الفرع', 'warning');
            return;
        }

        if (!treasuryId) {
            _showToast('اختر الخزينة', 'warning');
            return;
        }

        if (!lines.length) {
            _showToast('أضف حساب إيراد واحدًا على الأقل', 'warning');
            return;
        }

        var seen = {};

        for (var i = 0; i < lines.length; i++) {
            seen[lines[i].account_id] =
                (seen[lines[i].account_id] || 0) + 1;

            if (seen[lines[i].account_id] > 1) {
                _showToast(
                    'لا تكرر نفس حساب الإيراد داخل السند؛ اجمع المبلغ في بند واحد.',
                    'warning'
                );
                return;
            }
        }

        var total = lines.reduce(function(sum, line) {
            return sum +
                Number(line.amount || 0) +
                Number(line.tax_amount || 0);
        }, 0);

        if (!(total > 0)) {
            _showToast('إجمالي الإيراد يجب أن يكون أكبر من صفر', 'warning');
            return;
        }

        var operationId =
            host.dataset.revenueOperationId ||
            ((window.crypto && crypto.randomUUID)
                ? crypto.randomUUID()
                : String(Date.now()) + '-' + Math.random());

        host.dataset.revenueOperationId = operationId;
        host.dataset.revenueSaving = '1';

        _showLoader('جاري حفظ الإيراد وترحيله...');

        try {
            var companyId = _companyId();

            var result = await supabase.rpc(
                'finance_save_revenue',
                {
                    p_company_id: companyId,
                    p_revenue_id: null,
                    p_revenue_code:
                        'REV-' +
                        operationId
                            .replace(/-/g, '')
                            .slice(0, 16)
                            .toUpperCase(),
                    p_revenue_date: date,
                    p_payer_name: payerName || null,
                    p_category_id: categoryId || null,
                    p_treasury_id: treasuryId,
                    p_branch_id: branchId,
                    p_description: description || 'إيراد',
                    p_attachment_url: null,
                    p_reference: reference || null,
                    p_created_by:
                        (RW_STATE.user && RW_STATE.user.email) ||
                        'mother',
                    p_operation_id: operationId,
                    p_lines: lines
                }
            );

            if (result.error) throw result.error;

            var data = result.data || {};

            delete host.dataset.revenueOperationId;
            host.dataset.revenueSaving = '0';

            _showToast(
                data.duplicate
                    ? 'الإيراد موجود بالفعل ولم يُكرر.'
                    : 'تم حفظ الإيراد وترحيله بنجاح.',
                'success'
            );

            await renderSubTab('revenues');

        } catch (e) {
            _showToast(
                e.message || 'فشل حفظ الإيراد',
                'error'
            );
        } finally {
            host.dataset.revenueSaving = '0';
            _hideLoader();
        }
    }

