                '<div class="mt-2 text-gray-500">جاري تحميل الإيرادات...</div>' +
            '</div>'
        );

        Promise.all([
            supabase.from('finance_revenues')
                .select('*')
                .eq('company_id', companyId)
                .order('revenue_date', { ascending: false })
                .order('created_at', { ascending: false }),

            supabase.from('finance_revenue_categories')
                .select('id,code,name')
                .eq('company_id', companyId)
                .eq('is_active', true)
        ])
        .then(function(results) {
            var revenueResult = results[0];
            var categoryResult = results[1];

            if (revenueResult.error) throw revenueResult.error;
            if (categoryResult.error) throw categoryResult.error;

            var rows = revenueResult.data || [];
            var categories = categoryResult.data || [];

            var categoryMap = {};
            categories.forEach(function(c) {
                categoryMap[c.id] = c.name || c.code;
            });

            var revenueAccounts = {};
            _cache.accountsFlat.forEach(function(a) {
                revenueAccounts[a.id] =
                    a.account_name + ' (' + a.account_code + ')';
            });

            var totalPosted = 0;
            var totalVoided = 0;

            rows.forEach(function(r) {
                var amount =
                    Number(r.total_amount || 0) +
                    Number(r.tax_amount || 0);

                if (r.status === 'VOID') {
                    totalVoided += amount;
                } else {
                    totalPosted += amount;
                }
            });

            var html =
                '<div class="space-y-5">' +

                    '<div class="flex flex-wrap justify-between items-center gap-3">' +
                        '<div>' +
                            '<h2 class="text-2xl font-black text-emerald-800">' +
                                '<i class="fa-solid fa-money-bill-trend-up ml-2"></i>' +
                                'الإيرادات' +
                            '</h2>' +
                            '<div class="text-sm text-gray-500 mt-1">' +
                                'سجل الإيرادات المرحّلة المرتبطة بالخزينة والحسابات.' +
                            '</div>' +
                        '</div>' +

                        '<button type="button" ' +
                            'onclick="RW_Finance._newReceipt()" ' +
                            'class="bg-emerald-600 text-white px-5 py-3 rounded-xl font-black">' +
                            '<i class="fa-solid fa-plus ml-1"></i>' +
                            ' إيراد جديد' +
                        '</button>' +
                    '</div>' +

                    '<div class="grid grid-cols-1 md:grid-cols-3 gap-3">' +

                        '<div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5">' +
                            '<div class="text-sm text-emerald-700">صافي الإيرادات المرحّلة</div>' +
                            '<div class="text-3xl font-black text-emerald-800 mt-1">' +
                                _fmtNum(totalPosted - totalVoided) +
                            '</div>' +
                        '</div>' +

                        '<div class="bg-slate-50 border rounded-2xl p-5">' +
                            '<div class="text-sm text-gray-500">عدد السندات</div>' +
                            '<div class="text-3xl font-black mt-1">' +
                                String(rows.length) +
                            '</div>' +
                        '</div>' +

                        '<div class="bg-amber-50 border border-amber-100 rounded-2xl p-5">' +
                            '<div class="text-sm text-amber-700">المعكوس</div>' +
                            '<div class="text-3xl font-black text-amber-800 mt-1">' +
                                _fmtNum(totalVoided) +
                            '</div>' +
                        '</div>' +

                    '</div>' +

                    '<div class="bg-white rounded-2xl shadow-sm border overflow-hidden">' +
                        '<div class="overflow-x-auto">' +
                            '<table class="w-full text-sm border-collapse">' +
                                '<thead>' +
                                    '<tr class="bg-emerald-50">' +
                                        '<th class="p-3 border">السند</th>' +
                                        '<th class="p-3 border">التاريخ</th>' +
                                        '<th class="p-3 border">الدافع</th>' +
                                        '<th class="p-3 border">الفئة</th>' +
                                        '<th class="p-3 border">الحسابات</th>' +
                                        '<th class="p-3 border">الخزينة</th>' +
                                        '<th class="p-3 border">الفرع</th>' +
                                        '<th class="p-3 border">المبلغ</th>' +
                                        '<th class="p-3 border">الحالة</th>' +
                                    '</tr>' +
                                '</thead>' +
                                '<tbody>';

            if (!rows.length) {
                html +=
                    '<tr>' +
                        '<td colspan="9" class="p-10 text-center text-gray-500">' +
                            'لا توجد إيرادات مسجلة بعد.' +
                        '</td>' +
                    '</tr>';
            } else {
                var lineQueryIds = rows.map(function(r) { return r.id; });

                return supabase.from('finance_revenue_lines')
                    .select('revenue_id,account_id,amount,tax_amount')
                    .eq('company_id', companyId)
                    .in('revenue_id', lineQueryIds)
                    .then(function(lineResult) {
                        if (lineResult.error) throw lineResult.error;

                        var lineMap = {};

                        (lineResult.data || []).forEach(function(line) {
                            if (!lineMap[line.revenue_id]) {
                                lineMap[line.revenue_id] = [];
                            }

                            lineMap[line.revenue_id].push(
                                revenueAccounts[line.account_id] ||
                                line.account_id
                            );
                        });

                        rows.forEach(function(r) {
                            var amount =
                                Number(r.total_amount || 0) +
                                Number(r.tax_amount || 0);

                            var statusLabel =
                                r.status === 'VOID'
                                    ? 'معكوس'
                                    : 'مرحّل';

                            var statusClass =
                                r.status === 'VOID'
                                    ? 'text-red-700 bg-red-50'
                                    : 'text-emerald-700 bg-emerald-50';

                            var branch = null;
                            var treasury = null;

                            for (var i = 0; i < branchesForRevenue.length; i++) {
                                if (branchesForRevenue[i].id === r.branch_id) {
                                    branch = branchesForRevenue[i];
                                    break;
                                }
                            }

                            for (var j = 0; j < _cache.treasury.length; j++) {
                                if (_cache.treasury[j].id === r.treasury_id) {
                                    treasury = _cache.treasury[j];
                                    break;
                                }
                            }

                            html +=
                                '<tr class="border-t hover:bg-emerald-50/40">' +
                                    '<td class="p-3 border font-black text-emerald-700">' +
                                        _esc(r.revenue_code) +
                                    '</td>' +

                                    '<td class="p-3 border">' +
                                        _esc(r.revenue_date || '') +
                                    '</td>' +

                                    '<td class="p-3 border">' +
                                        _esc(r.payer_name || '-') +
                                    '</td>' +

                                    '<td class="p-3 border">' +
                                        _esc(categoryMap[r.category_id] || '-') +
                                    '</td>' +

                                    '<td class="p-3 border">' +
                                        _esc(
                                            (lineMap[r.id] || []).join('، ') ||
                                            '-'
                                        ) +
                                    '</td>' +

                                    '<td class="p-3 border">' +
                                        _esc(
                                            treasury
                                                ? treasury.account_name
                                                : r.treasury_id
                                        ) +
                                    '</td>' +

                                    '<td class="p-3 border">' +
                                        _esc(
                                            branch
                                                ? (branch.name || branch.branch_code)
                                                : r.branch_id
                                        ) +
                                    '</td>' +

                                    '<td class="p-3 border text-left font-black text-emerald-700">' +
                                        _fmtNum(amount) +
                                    '</td>' +

                                    '<td class="p-3 border text-center">' +
                                        '<span class="px-3 py-1 rounded-full text-xs font-black ' +
                                            statusClass +
                                        '">' +
                                            statusLabel +
                                        '</span>' +
                                    '</td>' +

                                '</tr>';
                        });

                        html +=
                                '</tbody>' +
                            '</table>' +
                        '</div>' +
                    '</div>' +
                '</div>';

                safeHTML(content, html);
            })
            .catch(function(e) {
                safeHTML(
                    content,
                    '<div class="text-center py-10 text-red-500">' +
                        _esc(e.message || 'فشل تحميل الإيرادات') +
                    '</div>'
                );
            });
        })
        .catch(function(e) {
            safeHTML(
                content,
                '<div class="text-center py-10 text-red-500">' +
                    _esc(e.message || 'فشل تحميل الإيرادات') +
                '</div>'
            );
        });
    }

تنبيه مهم على هذه الكتلة: قبل دمجها، يوجد متغير واحد يجب تصحيحه داخل _renderRevenues: branchesForRevenue يجب تحميله من branches مثل branchResult.data; لا تستخدم الكتلة كما هي حرفيًا دون هذا التصحيح. لذلك استبدل داخل _renderRevenues:

var rows = revenueResult.data || [];
var categories = categoryResult.data || [];

بـ:

var rows = revenueResult.data || [];
var categories = categoryResult.data || [];
var branchesForRevenue = [];

ويجب أن يكون الاستدعاء الثالث للفروع موجودًا في Promise.all. هذه الملاحظة تمنعني من وصف الكتلة بأنها جاهزة 100% للدمج كما هي.

