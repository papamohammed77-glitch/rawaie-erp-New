                data = ledgerRes.data || [];

                html =
                    '<h4 class="font-bold mb-3">كشف حساب العميل</h4>' +
                    _tableHeader([
                        { label: 'التاريخ' },
                        { label: 'البيان' },
                        { label: 'مدين', center: true },
                        { label: 'دائن', center: true },
                        { label: 'الرصيد', center: true }
                    ]);

                for (var li = 0; li < data.length; li++) {
                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2">' +
                        _esc(data[li].entry_date) +
                        '</td>' +
                        '<td class="p-2">' +
                        _esc(data[li].description || '') +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        _fmtNum(data[li].debit) +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        _fmtNum(data[li].credit) +
                        '</td>' +
                        '<td class="p-2 text-center font-bold">' +
                        _fmtNum(data[li].balance) +
                        '</td>' +
                        '</tr>';
                }

                html += '</tbody></table>';

                if (!data.length) {
                    html += _empty(
                        'لا توجد حركات مالية لهذا العميل'
                    );
                }
            }

            else if (reportId === 'sales-runsheet-performance') {
                var rsPerfQuery = supabase
                    .from('runsheets')
                    .select(
                        'id, runsheet_code, run_date, status, total_amount, driver_id'
                    )
                    .eq('company_id', companyId);

                rsPerfQuery = _dateFilter(
                    rsPerfQuery,
                    'run_date'
                );

                var rpr = await rsPerfQuery;

                if (rpr.error) throw rpr.error;

                data = rpr.data || [];

                if (!data.length) {
                    html = _empty(
                        'لا توجد رانشيتات خلال الفترة المحددة'
                    );
                } else {
                    var rsTotal = 0;

                    html =
                        '<h4 class="font-bold mb-3">أداء الرانشيتات</h4>' +
                        _tableHeader([
                            { label: 'الرانشيت' },
                            { label: 'التاريخ' },
                            { label: 'الحالة' },
                            { label: 'القيمة', center: true }
                        ]);

                    for (var rp = 0; rp < data.length; rp++) {
                        rsTotal +=
                            Number(data[rp].total_amount) || 0;

                        html +=
                            '<tr class="border-t hover:bg-gray-50 cursor-pointer" ' +
                            'onclick="RW_Reports_Comprehensive._showRunsheetDetail(\'' +
                            _esc(data[rp].runsheet_code) +
                            '\')">' +

                            '<td class="p-2 font-bold">' +
                            _esc(data[rp].runsheet_code) +
                            '</td>' +

                            '<td class="p-2">' +
                            _esc(data[rp].run_date) +
                            '</td>' +

                            '<td class="p-2">' +
                            _esc(data[rp].status) +
                            '</td>' +

                            '<td class="p-2 text-center font-bold">' +
                            _fmtNum(data[rp].total_amount) +
                            ' EGP</td>' +

                            '</tr>';
                    }

                    html +=
                        '</tbody></table>' +
                        '<div class="mt-4 font-bold">' +
                        'إجمالي قيمة الرانشيتات: ' +
                        _fmtNum(rsTotal) +
                        ' EGP</div>';
                }
            }

            /* =========================================================
               INVENTORY
               ========================================================= */

            else if (
                reportId === 'inventory-stock' ||
                reportId === 'inventory-low-stock'
            ) {
                var branchesRes = await supabase
                    .from('branches')
                    .select('id, name, branch_code')
                    .eq('company_id', companyId);

                if (branchesRes.error) {
                    throw branchesRes.error;
                }

                var reportBranchIds =
                    (branchesRes.data || [])
                        .map(function(b) {
                            return b.id;
                        })
                        .filter(Boolean);

                var stockRows = [];

                if (reportBranchIds.length) {
                    var stockQ = await supabase
                        .from('stock_branches')
                        .select(
                            'branch_id, item_id, qty, allocated_qty, available_qty'
                        )
                        .in(
                            'branch_id',
                            reportBranchIds
                        );

                    if (stockQ.error) throw stockQ.error;

                    stockRows = stockQ.data || [];
                }

                var masterItems =
                    RW_STATE &&
                    RW_STATE.data &&
                    Array.isArray(RW_STATE.data.items)
                        ? RW_STATE.data.items
                        : [];

                if (!masterItems.length) {
                    var masterRes = await supabase
                        .from('items')
                        .select(
                            'id, item_code, name, unit, cost_price, reorder_point, max_qty'
                        );

                    if (masterRes.error) {
                        throw masterRes.error;
                    }

                    masterItems = masterRes.data || [];
                }

                var stockByItem = {};

                for (var sb = 0; sb < stockRows.length; sb++) {
                    var sr = stockRows[sb];

                    if (!sr.item_id) continue;

                    if (!stockByItem[sr.item_id]) {
                        stockByItem[sr.item_id] = {
                            physical: 0,
                            allocated: 0,
                            available: 0
                        };
                    }

                    stockByItem[sr.item_id].physical +=
                        Number(sr.qty) || 0;

                    stockByItem[sr.item_id].allocated +=
                        Number(sr.allocated_qty) || 0;

                    stockByItem[sr.item_id].available +=
                        sr.available_qty != null
                            ? Number(sr.available_qty) || 0
                            : Math.max(
                                0,
                                (Number(sr.qty) || 0) -
                                (Number(sr.allocated_qty) || 0)
                            );
                }

                var inventoryRows = [];

                for (var mi = 0; mi < masterItems.length; mi++) {
                    var mItem = masterItems[mi];

                    if (!mItem || !mItem.id) continue;

                    var stock = stockByItem[mItem.id] || {
                        physical: 0,
                        allocated: 0,
                        available: 0
                    };

                    var reorder =
                        Number(mItem.reorder_point);

                    if (!Number.isFinite(reorder) || reorder < 0) {
                        reorder = 5;
                    }

                    if (
                        reportId === 'inventory-low-stock' &&
                        stock.available > reorder
                    ) {
                        continue;
                    }

                    inventoryRows.push({
                        item: mItem,
                        stock: stock,
                        reorder: reorder
                    });
                }

                inventoryRows.sort(function(a, b) {
                    return b.stock.available -
                        a.stock.available;
                });

                if (
                    reportId === 'inventory-low-stock' &&
                    !inventoryRows.length
                ) {
                    html = _empty(
                        'لا توجد أصناف أقل من حد الطلب'
                    );
                } else {
                    html =
                        '<h4 class="font-bold mb-3">' +
                        (reportId === 'inventory-stock'
                            ? 'جرد المخزون الحالي'
                            : 'الأصناف الأقل من حد الطلب') +
                        '</h4>' +

                        _tableHeader([
                            { label: 'الصنف' },
                            { label: 'الكود' },
                            { label: 'الرصيد الفعلي', center: true },
                            { label: 'المحجوز', center: true },
                            { label: 'المتاح', center: true },
                            { label: 'حد الطلب', center: true }
                        ]);

                    for (
                        var ir = 0;
                        ir < inventoryRows.length;
                        ir++
                    ) {
                        var inv = inventoryRows[ir];

                        html +=
                            '<tr class="border-t">' +
                            '<td class="p-2 font-semibold">' +
                            _esc(inv.item.name) +
                            '</td>' +
                            '<td class="p-2">' +
                            _esc(inv.item.item_code) +
                            '</td>' +
                            '<td class="p-2 text-center">' +
                            _fmtNum(inv.stock.physical) +
                            '</td>' +
                            '<td class="p-2 text-center">' +
                            _fmtNum(inv.stock.allocated) +
                            '</td>' +
                            '<td class="p-2 text-center font-bold">' +
                            _fmtNum(inv.stock.available) +
                            '</td>' +
                            '<td class="p-2 text-center">' +
                            _fmtNum(inv.reorder) +
                            '</td>' +
                            '</tr>';
                    }

                    html += '</tbody></table>';
                }
            }

            else if (reportId === 'inventory-movement') {
                if (!itemCode) {
                    safeHTML(
                        resultDiv,
                        _empty('يرجى اختيار الصنف')
                    );
                    return;
                }

                var itemMovementQuery = supabase
                    .from('inventory_log')
                    .select('*')
                    .eq('company_id', companyId)
                    .eq('item_code', itemCode);

                itemMovementQuery = _dateFilter(
                    itemMovementQuery,
                    'movement_date'
                );

                var imr = await itemMovementQuery
                    .order('movement_date', {
                        ascending: false
                    })
                    .order('created_at', {
                        ascending: false
                    });

                if (imr.error) throw imr.error;

                data = imr.data || [];

                html =
                    '<h4 class="font-bold mb-3">حركة الصنف</h4>' +
                    _tableHeader([
                        { label: 'التاريخ' },
                        { label: 'النوع' },
                        { label: 'الكمية', center: true },
                        { label: 'المرجع' },
                        { label: 'المستخدم' }
                    ]);

                for (var mv = 0; mv < data.length; mv++) {
                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2">' +
                        _esc(data[mv].movement_date) +
                        '</td>' +
                        '<td class="p-2">' +
                        _esc(data[mv].movement_type) +
                        '</td>' +
                        '<td class="p-2 text-center font-bold">' +
                        _fmtNum(data[mv].qty) +
                        '</td>' +
                        '<td class="p-2">' +
                        _esc(data[mv].reference || '') +
                        '</td>' +
                        '<td class="p-2">' +
                        _esc(data[mv].user_email || '') +
                        '</td>' +
                        '</tr>';
                }

                html += '</tbody></table>';

                if (!data.length) {
                    html += _empty(
                        'لا توجد حركات لهذا الصنف خلال الفترة'
                    );
                }
            }

            else if (reportId === 'inventory-dormant') {
                var dormantItemsRes = await supabase
                    .from('items')
                    .select(
                        'id, item_code, name, unit, cost_price, sales_price'
                    );

                if (dormantItemsRes.error) {
                    throw dormantItemsRes.error;
                }

                var dormantItems =
                    dormantItemsRes.data || [];

                var dormantOrdersQuery =
                    supabase
                        .from('order_details')
                        .select(
                            'item_code, orders!inner(company_id, order_date, order_status)'
                        )
                        .eq(
                            'orders.company_id',
                            companyId
                        )
                        .neq(
                            'orders.order_status',
                            'Cancelled'
                        );

                dormantOrdersQuery = _dateFilter(
                    dormantOrdersQuery,
                    'orders.order_date'
                );

                var dormantSoldRes =
                    await dormantOrdersQuery;

                if (dormantSoldRes.error) {
                    throw dormantSoldRes.error;
                }

                var soldMap = {};

                (dormantSoldRes.data || [])
                    .forEach(function(r) {
                        if (r && r.item_code) {
                            soldMap[r.item_code] = true;
                        }
                    });

                var dormantBranches = await supabase
                    .from('branches')
                    .select('id')
                    .eq('company_id', companyId);

                if (dormantBranches.error) {
                    throw dormantBranches.error;
                }

                var dormantBranchIds =
                    (dormantBranches.data || [])
                        .map(function(b) {
                            return b.id;
                        })
                        .filter(Boolean);

                var dormantStockRes = dormantBranchIds.length
                    ? await supabase
                        .from('stock_branches')
                        .select(
                            'item_id, qty, allocated_qty, available_qty'
                        )
                        .in(
                            'branch_id',
                            dormantBranchIds
                        )
                    : { data: [], error: null };

                if (dormantStockRes.error) {
                    throw dormantStockRes.error;
                }

                var dormantStockMap = {};

                (dormantStockRes.data || [])
                    .forEach(function(r) {
                        if (!r.item_id) return;

                        dormantStockMap[r.item_id] =
                            (dormantStockMap[r.item_id] || 0) +
                            (
                                r.available_qty != null
                                    ? Number(r.available_qty) || 0
                                    : Math.max(
                                        0,
                                        (Number(r.qty) || 0) -
                                        (Number(r.allocated_qty) || 0)
                                    )
                            );
                    });

                var dormantRows =
                    dormantItems.filter(function(it) {
                        return (
                            it &&
                            it.id &&
                            Number(
                                dormantStockMap[it.id] || 0
                            ) > 0 &&
                            !soldMap[it.item_code]
                        );
                    });

                html =
                    '<h4 class="font-bold mb-3">تحليل دوران المخزون — الأصناف الراكدة</h4>' +
                    _tableHeader([
                        { label: 'الصنف' },
                        { label: 'الكود' },
                        { label: 'المتاح', center: true },
                        { label: 'قيمة التكلفة التقديرية', center: true }
                    ]);

                for (var dmi = 0; dmi < dormantRows.length; dmi++) {
                    var dm = dormantRows[dmi];
                    var availableQty =
                        Number(
                            dormantStockMap[dm.id] || 0
                        );

                    var unitCost =
                        Number(dm.cost_price) ||
                        Number(dm.sales_price) ||
                        0;

                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2 font-semibold">' +
                        _esc(dm.name) +
                        '</td>' +
                        '<td class="p-2">' +
                        _esc(dm.item_code) +
                        '</td>' +
                        '<td class="p-2 text-center font-bold">' +
                        _fmtNum(availableQty) +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        _fmtNum(
                            availableQty * unitCost
                        ) +
                        ' EGP</td>' +
                        '</tr>';
                }

                html += '</tbody></table>';

                if (!dormantRows.length) {
                    html += _empty(
                        'لا توجد أصناف راكدة وفق بيانات الفترة والمخزون الحالية'
                    );
                }
            }

            /* =========================================================
               PURCHASES / RECEIVING
               ========================================================= */

            else if (reportId === 'purchase-by-supplier') {
                var poSupplierQuery = supabase
                    .from('purchase_orders')
                    .select(
                        'supplier_id, supplier_name, total_amount, po_date, status'
                    )
                    .eq('company_id', companyId);

                poSupplierQuery = _dateFilter(
                    poSupplierQuery,
                    'po_date'
                );

                if (supplier) {
                    poSupplierQuery =
                        poSupplierQuery.eq(
                            'supplier_id',
                            supplier
                        );
                }

                var psr = await poSupplierQuery;

                if (psr.error) throw psr.error;

                var poMap = {};

                (psr.data || []).forEach(function(row) {
                    var sid =
                        row.supplier_id ||
                        'غير محدد';

                    if (!poMap[sid]) {
                        poMap[sid] = {
                            id: sid,
                            name:
                                row.supplier_name ||
                                sid,
                            count: 0,
                            total: 0
                        };
                    }

                    poMap[sid].count++;
                    poMap[sid].total +=
                        Number(row.total_amount) || 0;
                });

                var poArr =
                    Object.keys(poMap)
                        .map(function(k) {
                            return poMap[k];
                        })
                        .sort(function(a, b) {
                            return b.total - a.total;
                        });

                html =
                    '<h4 class="font-bold mb-3">المشتريات حسب المورد</h4>' +
                    _tableHeader([
                        { label: 'المورد' },
                        { label: 'عدد الأوامر', center: true },
                        { label: 'الإجمالي', center: true }
                    ]);

                for (var poi = 0; poi < poArr.length; poi++) {
                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2 font-semibold">' +
                        _esc(poArr[poi].name) +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        poArr[poi].count +
                        '</td>' +
                        '<td class="p-2 text-center font-bold">' +
                        _fmtNum(poArr[poi].total) +
                        ' EGP</td>' +
                        '</tr>';
                }

                html += '</tbody></table>';
            }

            else if (reportId === 'purchase-order-status') {
                var poStatusQuery = supabase
                    .from('purchase_orders')
                    .select('status, po_date')
                    .eq('company_id', companyId);

                poStatusQuery = _dateFilter(
                    poStatusQuery,
                    'po_date'
                );

                var por = await poStatusQuery;

                if (por.error) throw por.error;

                var poStatusMap = {};

                (por.data || []).forEach(function(row) {
                    var st =
                        row.status ||
                        'غير محدد';

                    poStatusMap[st] =
                        (poStatusMap[st] || 0) + 1;
                });

                html =
                    '<h4 class="font-bold mb-3">حالة أوامر الشراء</h4>' +
                    _tableHeader([
                        { label: 'الحالة' },
                        { label: 'العدد', center: true }
                    ]);

                Object.keys(poStatusMap)
                    .sort()
                    .forEach(function(st) {
                        html +=
                            '<tr class="border-t">' +
                            '<td class="p-2">' +
                            _esc(st) +
                            '</td>' +
                            '<td class="p-2 text-center font-bold">' +
                            poStatusMap[st] +
                            '</td>' +
                            '</tr>';
                    });

                html += '</tbody></table>';
            }

            else if (reportId === 'purchase-receiving') {
                var receivingRes = await supabase
                    .from('receiving')
                    .select('operation_id, po_number, date, company_id')
                    .eq('company_id', companyId);

                if (receivingRes.error) {
                    throw receivingRes.error;
                }

                var receivingRows =
                    receivingRes.data || [];

                var operationIds =
                    receivingRows
                        .map(function(r) {
                            return r.operation_id;
                        })
                        .filter(Boolean);

                var receivingDetailRows = [];

                if (operationIds.length) {
                    var rdRes = await supabase
                        .from('receiving_details')
                        .select(
                            'operation_id, item_code, item_name, qty_expected, qty_received, difference, reason, created_at'
                        )
                        .in(
                            'operation_id',
                            operationIds
                        );

                    if (rdRes.error) {
                        throw rdRes.error;
                    }

                    receivingDetailRows =
                        rdRes.data || [];
                }

                receivingDetailRows =
                    receivingDetailRows.filter(function(r) {
                        if (!fromDate && !toDate) return true;

                        var rowDate =
                            r.created_at
                                ? String(r.created_at)
                                    .slice(0, 10)
                                : '';

                        if (
                            fromDate &&
                            rowDate < fromDate
                        ) return false;

                        if (
                            toDate &&
                            rowDate > toDate
                        ) return false;

                        return true;
                    });

                html =
                    '<h4 class="font-bold mb-3">تقرير استلام البضاعة</h4>' +
                    _tableHeader([
                        { label: 'الصنف' },
                        { label: 'المطلوب', center: true },
                        { label: 'المستلم', center: true },
                        { label: 'الفرق', center: true },
                        { label: 'السبب' }
                    ]);

                for (
                    var rdi = 0;
                    rdi < receivingDetailRows.length;
                    rdi++
                ) {
                    var rr = receivingDetailRows[rdi];

                    var receivingDiff =
                        Number(
                            rr.difference
                        );

                    if (!Number.isFinite(receivingDiff)) {
                        receivingDiff =
                            (Number(rr.qty_received) || 0) -
                            (Number(rr.qty_expected) || 0);
                    }

                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2">' +
                        _esc(
                            rr.item_name ||
                            rr.item_code ||
                            ''
                        ) +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        _fmtNum(rr.qty_expected) +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        _fmtNum(rr.qty_received) +
                        '</td>' +
                        '<td class="p-2 text-center font-bold ' +
                        (receivingDiff < 0
                            ? 'text-red-600'
                            : 'text-green-600') +
                        '">' +
                        _fmtNum(receivingDiff) +
                        '</td>' +
                        '<td class="p-2">' +
                        _esc(rr.reason || '') +
                        '</td>' +
                        '</tr>';
                }

                html += '</tbody></table>';

                if (!receivingDetailRows.length) {
                    html += _empty(
                        'لا توجد عمليات استلام ضمن بيانات الشركة والفترة المحددة'
                    );
                }
            }

            /* =========================================================
               FINANCE
               ========================================================= */

            else if (reportId === 'finance-trial-balance') {
                if (!fromDate || !toDate) {
                    safeHTML(
                        resultDiv,
                        _empty(
                            'يجب تحديد الفترة الزمنية لميزان المراجعة'
                        )
                    );
                    return;
                }

                var trialRes = await supabase.rpc(
                    'get_trial_balance',
                    {
                        p_from_date: fromDate,
                        p_to_date: toDate
                    }
                );

                if (trialRes.error) {
                    throw trialRes.error;
                }

                var trialRows =
                    trialRes.data || [];

                html =
                    '<h4 class="font-bold mb-3">ميزان المراجعة</h4>' +
                    _tableHeader([
                        { label: 'الحساب' },
                        { label: 'المدين', center: true },
                        { label: 'الدائن', center: true },
                        { label: 'الرصيد', center: true }
                    ]);

                for (var tb = 0; tb < trialRows.length; tb++) {
                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2 font-semibold">' +
                        _esc(
                            trialRows[tb].account_name ||
                            trialRows[tb].account_id ||
                            ''
                        ) +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        _fmtNum(
                            trialRows[tb].total_debit
                        ) +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        _fmtNum(
                            trialRows[tb].total_credit
                        ) +
                        '</td>' +
                        '<td class="p-2 text-center font-bold">' +
                        _fmtNum(
                            trialRows[tb].net_balance
                        ) +
                        '</td>' +
                        '</tr>';
                }

                html += '</tbody></table>';
            }

            else if (reportId === 'finance-profit-loss') {
                if (!fromDate || !toDate) {
                    safeHTML(
                        resultDiv,
                        _empty(
                            'يجب تحديد الفترة الزمنية لقائمة الدخل'
                        )
                    );
                    return;
                }

                var pnlRes = await supabase.rpc(
                    'get_profit_loss',
                    {
                        p_from_date: fromDate,
                        p_to_date: toDate
                    }
                );

                if (pnlRes.error) {
                    throw pnlRes.error;
                }

                var pnlRows = pnlRes.data || [];

                var revenueTotal = 0;
                var expenseTotal = 0;

                pnlRows.forEach(function(row) {
                    var amount =
                        Number(row.total_amount) || 0;

                    if (row.account_type === 'revenue') {
                        revenueTotal += amount;
                    }

                    if (row.account_type === 'expense') {
                        expenseTotal += amount;
                    }
