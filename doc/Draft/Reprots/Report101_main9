                    .sort(function(a, b) {
                        var sa =
                            stockMap[a.id]
                                ? stockMap[a.id]
                                    .available
                                : 0;

                        var sb =
                            stockMap[b.id]
                                ? stockMap[b.id]
                                    .available
                                : 0;

                        return sa - sb;
                    });

            html +=
                '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
                '<h3 class="font-black text-lg mb-3">' +
                'أصناف منخفضة المخزون' +
                '</h3>' +
                '<table class="w-full text-sm">' +
                '<thead><tr class="bg-gray-50">' +
                '<th class="p-2">الصنف</th>' +
                '<th class="p-2 text-center">المتاح</th>' +
                '<th class="p-2 text-center">حد الطلب</th>' +
                '</tr></thead><tbody>';

            lowRows
                .slice(0, 30)
                .forEach(function(item) {
                    var reorder =
                        Number(
                            item.reorder_point
                        );

                    if (
                        !Number.isFinite(reorder) ||
                        reorder < 0
                    ) {
                        reorder = 5;
                    }

                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2 font-semibold">' +
                        _esc(item.name) +
                        '</td>' +
                        '<td class="p-2 text-center font-bold text-red-600">' +
                        _fmtNum(
                            stockMap[item.id]
                                ? stockMap[item.id]
                                    .available
                                : 0
                        ) +
                        '</td>' +
                        '<td class="p-2 text-center">' +
                        _fmtNum(reorder) +
                        '</td>' +
                        '</tr>';
                });

            html += '</tbody></table></div>';
        }

        if (
            selectedTypes.indexOf(
                'inventory-top'
            ) !== -1
        ) {
            var topMap = {};

            details.forEach(function(row) {
                if (!row || !row.item_code) {
                    return;
                }

                if (!topMap[row.item_code]) {
                    topMap[row.item_code] = {
                        name:
                            row.item_name ||
                            row.item_code,
                        qty: 0
                    };
                }

                topMap[row.item_code].qty +=
                    Number(row.qty) || 0;
            });

            var topItems =
                Object.keys(topMap)
                    .map(function(k) {
                        return topMap[k];
                    })
                    .sort(function(a, b) {
                        return b.qty - a.qty;
                    })
                    .slice(0, 30);

            html +=
                '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
                '<h3 class="font-black text-lg mb-3">' +
                'الأصناف الأعلى مبيعاً' +
                '</h3>' +
                '<table class="w-full text-sm">' +
                '<thead><tr class="bg-gray-50">' +
                '<th class="p-2">الصنف</th>' +
                '<th class="p-2 text-center">الكمية المباعة</th>' +
                '</tr></thead><tbody>';

            topItems.forEach(function(row) {
                html +=
                    '<tr class="border-t">' +
                    '<td class="p-2 font-semibold">' +
                    _esc(row.name) +
                    '</td>' +
                    '<td class="p-2 text-center font-bold">' +
                    _fmtNum(row.qty) +
                    '</td>' +
                    '</tr>';
            });

            html += '</tbody></table></div>';
        }

        if (
            selectedTypes.indexOf(
                'rec-purchase'
            ) !== -1
        ) {
            var purchaseRecommendations =
                items
                    .filter(function(item) {
                        if (!item || !item.id) {
                            return false;
                        }

                        var stock =
                            stockMap[item.id] || {
                                available: 0
                            };

                        var reorder =
                            Number(
                                item.reorder_point
                            );

                        if (
                            !Number.isFinite(reorder) ||
                            reorder < 0
                        ) {
                            reorder = 5;
                        }

                        return (
                            stock.available <=
                            reorder
                        );
                    })
                    .slice(0, 10);

            html +=
                '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
                '<h3 class="font-black text-lg mb-3">' +
                'توصيات الشراء' +
                '</h3>';

            if (purchaseRecommendations.length) {
                html +=
                    '<div class="space-y-3">';

                purchaseRecommendations
                    .forEach(function(item) {
                        var stock =
                            stockMap[item.id]
                                ? stockMap[item.id]
                                    .available
                                : 0;

                        var reorder =
                            Number(
                                item.reorder_point
                            );

                        if (
                            !Number.isFinite(reorder) ||
                            reorder < 0
                        ) {
                            reorder = 5;
                        }

                        var suggestedQty =
                            Math.max(
                                0,
                                (
                                    Number(
                                        item.max_qty
                                    ) || reorder * 2
                                ) -
                                stock
                            );

                        html +=
                            '<div class="border-r-4 border-indigo-500 bg-indigo-50 p-4 rounded-lg">' +
                            '<div class="font-bold">' +
                            _esc(item.name) +
                            '</div>' +
                            '<div class="text-sm text-gray-600 mt-1">' +
