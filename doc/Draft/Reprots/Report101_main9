واحذف الدالة كاملة حتى } الخاصة بها، واستبدلها بالكامل:

    async function _loadDropdowns(params) {
        try {
            var companyId = _companyId();

            function _resetSelect(selectEl, firstOption) {
                if (!selectEl) return;
                selectEl.innerHTML = firstOption || '<option value="">اختيار</option>';
            }

            function _appendOptions(selectEl, rows, valueField, labelField) {
                if (!selectEl) return;

                for (var i = 0; i < rows.length; i++) {
                    var row = rows[i] || {};
                    var option = document.createElement('option');

                    option.value =
                        row[valueField] == null
                            ? ''
                            : String(row[valueField]);

                    option.textContent =
                        row[labelField] == null
                            ? ''
                            : String(row[labelField]);

                    selectEl.appendChild(option);
                }
            }

            if (params.indexOf('customer') !== -1) {
                var customerSelect = byId('rp-customer');

                _resetSelect(
                    customerSelect,
                    '<option value="">جميع العملاء</option>'
                );

                var customerRes = await supabase
                    .from('customers')
                    .select('id, customer_code, name')
                    .eq('company_id', companyId)
                    .order('name', { ascending: true });

                if (customerRes.error) throw customerRes.error;

                _appendOptions(
                    customerSelect,
                    customerRes.data || [],
                    'id',
                    'name'
                );
            }

            if (params.indexOf('supplier') !== -1) {
                var supplierSelect = byId('rp-supplier');

                _resetSelect(
                    supplierSelect,
                    '<option value="">جميع الموردين</option>'
                );

                var supplierRes = await supabase
                    .from('suppliers')
                    .select('id, supplier_code, name')
                    .eq('company_id', companyId)
                    .order('name', { ascending: true });

                if (supplierRes.error) throw supplierRes.error;

                _appendOptions(
                    supplierSelect,
                    supplierRes.data || [],
                    'id',
                    'name'
                );
            }

            if (params.indexOf('item') !== -1) {
                var itemSelect = byId('rp-item');

                _resetSelect(
                    itemSelect,
                    '<option value="">جميع الأصناف</option>'
                );

                var itemRes = await supabase
                    .from('items')
                    .select('id, item_code, name')
                    .order('item_code', { ascending: true });

                if (itemRes.error) throw itemRes.error;

                _appendOptions(
                    itemSelect,
                    itemRes.data || [],
                    'item_code',
                    'name'
                );
            }

            if (params.indexOf('treasury') !== -1) {
                var treasurySelect = byId('rp-treasury');

                _resetSelect(
                    treasurySelect,
                    '<option value="">جميع الخزائن</option>'
                );

                var treasuryRes = await supabase
                    .from('treasury')
                    .select('id, account_code, account_name')
                    .eq('company_id', companyId)
                    .order('account_name', { ascending: true });

                if (treasuryRes.error) throw treasuryRes.error;

                _appendOptions(
                    treasurySelect,
                    treasuryRes.data || [],
                    'id',
                    'account_name'
                );
            }

            if (params.indexOf('account') !== -1) {
                var accountSelect = byId('rp-account');

                _resetSelect(
                    accountSelect,
                    '<option value="">اختر حساباً</option>'
                );

                var accountRes = await supabase
                    .from('chart_of_accounts')
                    .select('id, account_code, account_name')
                    .eq('company_id', companyId)
                    .eq('is_active', true)
                    .order('account_code', { ascending: true });

                if (accountRes.error) throw accountRes.error;

                _appendOptions(
                    accountSelect,
                    accountRes.data || [],
                    'id',
                    'account_name'
                );
            }

            if (params.indexOf('driver') !== -1) {
                var driverSelect = byId('rp-driver');

                _resetSelect(
                    driverSelect,
                    '<option value="">جميع السائقين</option>'
                );

                var driverRes = await supabase
                    .from('users')
                    .select('id, email, name')
                    .eq('company_id', companyId)
                    .in('role', ['driver', 'سائق', 'مندوب'])
                    .eq('status', 'Active')
                    .order('name', { ascending: true });

                if (driverRes.error) throw driverRes.error;

                _appendOptions(
                    driverSelect,
                    driverRes.data || [],
                    'id',
                    'name'
                );
            }

            if (params.indexOf('area') !== -1) {
                var areaSelect = byId('rp-area');

                _resetSelect(
                    areaSelect,
                    '<option value="">جميع المناطق</option>'
                );

                var areaRes = await supabase
                    .from('customers')
                    .select('area')
                    .eq('company_id', companyId)
                    .not('area', 'is', null)
                    .order('area', { ascending: true });

                if (areaRes.error) throw areaRes.error;

                var areaMap = {};
                var areaRows = areaRes.data || [];

                for (var a = 0; a < areaRows.length; a++) {
                    var areaName = String(areaRows[a].area || '').trim();

                    if (areaName) {
                        areaMap[areaName] = true;
                    }
                }

                var areaList = Object.keys(areaMap).sort(function(a, b) {
                    return a.localeCompare(b, 'ar');
                });

                for (var ar = 0; ar < areaList.length; ar++) {
                    var option = document.createElement('option');
                    option.value = areaList[ar];
                    option.textContent = areaList[ar];
                    areaSelect.appendChild(option);
                }
            }

        } catch (e) {
            console.error(
                'RW_Reports_Comprehensive._loadDropdowns',
                e
            );

            _showToast(
                'فشل تحميل معايير التقرير',
                'error'
            );
        }
    }

المهم:
Customer / Supplier / Treasury / Account / Driver أصبحت UUID identity، بينما Item بقي item_code لأن Production يثبت items.item_code UNIQUE عالميًا. وهذا يتفق مع عقد الهوية المثبت في الحوكمة.

