                    if (!item || !item.id) {
                        return false;
                    }

                    return (
                        stockMap[item.id] &&
                        stockMap[item.id].available >
                        0 &&
                        !soldCodes[item.item_code]
                    );
                }).slice(0, 10);

            html +=
                '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
                '<h3 class="font-black text-lg mb-3">' +
                'مرشحون للعروض' +
                '</h3>';

            if (offerCandidates.length) {
                html +=
                    '<div class="grid grid-cols-1 md:grid-cols-2 gap-3">';

                offerCandidates
                    .forEach(function(item) {
                        html +=
                            '<div class="border rounded-xl p-4 bg-amber-50">' +
                            '<p class="font-bold">' +
                            _esc(item.name) +
                            '</p>' +
                            '<p class="text-sm text-gray-600 mt-1">' +
                            'الصنف لم يسجل مبيعات ضمن الفترة المحددة ولديه مخزون متاح.' +
                            '</p>' +
                            '</div>';
                    });

                html += '</div>';
            } else {
                html +=
                    '<div class="text-center py-4 text-gray-500">' +
                    'لا توجد مرشحات عروض من البيانات الحالية.' +
                    '</div>';
            }

            html += '</div>';
        }

        if (
            selectedTypes.indexOf(
                'rec-customers'
            ) !== -1
        ) {
            var activeCustomerIds = {};

            orders.forEach(function(order) {
                if (order.customer_id) {
                    activeCustomerIds[
                        order.customer_id
                    ] = true;
                }
            });

            var customerRecommendations =
                customers
                    .filter(function(c) {
                        return (
                            c &&
                            c.id &&
                            !activeCustomerIds[c.id]
                        );
                    })
                    .slice(0, 20);

            html +=
                '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
                '<h3 class="font-black text-lg mb-3">' +
                'توصيات العملاء' +
                '</h3>' +
                '<p class="text-sm text-gray-500 mb-3">' +
                'عملاء موجودون في الشركة لكنهم لم يظهروا في حركة الطلبات ضمن الفترة المحددة.' +
                '</p>' +
                '<table class="w-full text-sm">' +
                '<thead><tr class="bg-gray-50">' +
                '<th class="p-2">الكود</th>' +
                '<th class="p-2">الاسم</th>' +
                '<th class="p-2">المنطقة</th>' +
                '</tr></thead><tbody>';

            customerRecommendations
                .forEach(function(c) {
                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2">' +
                        _esc(c.customer_code) +
                        '</td>' +
                        '<td class="p-2 font-semibold">' +
                        _esc(c.name) +
                        '</td>' +
                        '<td class="p-2">' +
                        _esc(c.area || '') +
                        '</td>' +
                        '</tr>';
                });

            html += '</tbody></table></div>';
        }

        if (
            selectedTypes.indexOf(
                'rec-expansion'
            ) !== -1
        ) {
            var areaExpansionMap = {};

            customers.forEach(function(c) {
                var area =
                    String(
                        c.area ||
                        'غير محدد'
                    ).trim();

                areaExpansionMap[area] =
                    (areaExpansionMap[area] || 0) + 1;
            });

            html +=
                '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
                '<h3 class="font-black text-lg mb-3">' +
                'مؤشرات التوسع' +
                '</h3>' +
                '<p class="text-sm text-gray-500 mb-3">' +
                'توزيع قاعدة العملاء الحالية حسب المنطقة من بيانات Production.' +
                '</p>' +
                '<table class="w-full text-sm">' +
                '<thead><tr class="bg-gray-50">' +
                '<th class="p-2">المنطقة</th>' +
                '<th class="p-2 text-center">العملاء</th>' +
                '</tr></thead><tbody>';

            Object.keys(areaExpansionMap)
                .sort(function(a, b) {
                    return areaExpansionMap[b] -
                        areaExpansionMap[a];
                })
                .forEach(function(area) {
                    html +=
                        '<tr class="border-t">' +
                        '<td class="p-2">' +
                        _esc(area) +
                        '</td>' +
                        '<td class="p-2 text-center font-bold">' +
                        areaExpansionMap[area] +
                        '</td>' +
                        '</tr>';
                });

            html += '</tbody></table></div>';
        }

        html += '</div>';

        safeHTML(
            container,
            html
        );

    } catch (e) {
        console.error(
            'RW_Reports._loadDetailedReports',
            e
        );

        safeHTML(
            container,
            '<div class="text-center py-10 text-red-500">' +
            'فشل تحميل التقارير المحددة: ' +
            _esc(
                e && e.message
                    ? e.message
                    : 'خطأ غير معروف'
            ) +
            '</div>'
        );
    }
}
