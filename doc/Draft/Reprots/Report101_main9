async function _loadDetailedReports(fromDate, toDate, types) {
    var container = byId('det-result-container');
    if (!container) return;

    safeHTML(
        container,
        '<div class="text-center py-10">' +
        '<i class="fa-solid fa-spinner fa-spin text-2xl"></i>' +
        '<p class="mt-2 text-gray-500">جاري تحميل التقارير المحددة...</p>' +
        '</div>'
    );

    try {
        var companyId = _companyId();
        var selectedTypes =
            Array.isArray(types) ? types : [];

        var items =
            RW_STATE &&
            RW_STATE.data &&
            Array.isArray(RW_STATE.data.items)
                ? RW_STATE.data.items
                : [];

        if (!items.length) {
            var itemRes = await supabase
                .from('items')
                .select(
                    'id, item_code, name, unit, cost_price, sales_price, reorder_point'
                );

            if (itemRes.error) throw itemRes.error;

            items = itemRes.data || [];
        }

        var customers =
            RW_STATE &&
            RW_STATE.data &&
            Array.isArray(RW_STATE.data.customers)
                ? RW_STATE.data.customers
                : [];

        if (!customers.length) {
            var customerRes = await supabase
                .from('customers')
                .select(
                    'id, customer_code, name, area, debt, is_active'
                )
                .eq('company_id', companyId);

            if (customerRes.error) throw customerRes.error;

            customers = customerRes.data || [];
        } else {
            customers = customers.filter(function(c) {
                return c && c.id;
            });
        }

        var branchRes = await supabase
            .from('branches')
            .select('id')
            .eq('company_id', companyId);

        if (branchRes.error) throw branchRes.error;

        var branchIds =
            (branchRes.data || [])
                .map(function(b) {
                    return b.id;
                })
                .filter(Boolean);

        var stockData = [];

        if (branchIds.length) {
            var stockRes = await supabase
                .from('stock_branches')
                .select(
                    'item_id, qty, allocated_qty, available_qty, branch_id'
                )
                .in('branch_id', branchIds);

            if (stockRes.error) throw stockRes.error;

            stockData = stockRes.data || [];
        }

        var stockMap = {};

        for (var s = 0; s < stockData.length; s++) {
            var stock = stockData[s];

            if (!stock || !stock.item_id) continue;

            if (!stockMap[stock.item_id]) {
                stockMap[stock.item_id] = {
                    physical: 0,
                    allocated: 0,
                    available: 0
                };
            }

            stockMap[stock.item_id].physical +=
                Number(stock.qty) || 0;

            stockMap[stock.item_id].allocated +=
                Number(stock.allocated_qty) || 0;

            stockMap[stock.item_id].available +=
                stock.available_qty != null
                    ? Number(stock.available_qty) || 0
                    : Math.max(
                        0,
                        (Number(stock.qty) || 0) -
                        (Number(stock.allocated_qty) || 0)
                    );
        }

        var orderQuery = supabase
            .from('orders')
            .select(
                'id, order_code, customer_id, customer_name, total_amount, order_date, area, order_status, branch_id'
            )
            .eq('company_id', companyId);

        if (fromDate) {
            orderQuery =
                orderQuery.gte(
                    'order_date',
                    fromDate
                );
        }

        if (toDate) {
            orderQuery =
                orderQuery.lt(
                    'order_date',
                    _nextDate(toDate)
                );
        }

        var ordersRes =
            await orderQuery;

        if (ordersRes.error) {
            throw ordersRes.error;
        }

        var orders =
            ordersRes.data || [];

        var orderIds =
            orders
                .map(function(o) {
                    return o.id;
                })
                .filter(Boolean);

        var details = [];

        if (orderIds.length) {
            var detailsRes =
                await supabase
                    .from('order_details')
                    .select(
                        'item_code, item_name, qty, unit_price, order_id'
                    )
                    .in(
                        'order_id',
                        orderIds
                    );

            if (detailsRes.error) {
                throw detailsRes.error;
            }

            details =
                detailsRes.data || [];
        }

        var soldCodes = {};

        for (var d = 0; d < details.length; d++) {
            if (
                details[d] &&
                details[d].item_code
            ) {
                soldCodes[
                    details[d].item_code
                ] = true;
            }
        }

        var html =
            '<div class="text-right space-y-6">' +

            '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
            '<p class="text-sm text-gray-500">' +
            '<strong>الفترة:</strong> من ' +
            _esc(fromDate || '') +
            ' إلى ' +
            _esc(toDate || '') +
            '</p>' +
            '</div>';

        if (
            selectedTypes.indexOf(
                'sales-summary'
            ) !== -1
        ) {
            var totalSales = 0;

            for (var o = 0; o < orders.length; o++) {
                totalSales +=
                    Number(
                        orders[o].total_amount
                    ) || 0;
            }

            var average =
                orders.length
                    ? totalSales / orders.length
                    : 0;

            html +=
                '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
                '<h3 class="font-black text-lg mb-3">' +
                'ملخص المبيعات' +
                '</h3>' +
                '<div class="grid grid-cols-1 md:grid-cols-3 gap-4">' +

                '<div class="bg-indigo-50 rounded-xl p-4 text-center">' +
                '<p class="text-xs">عدد الأوردرات</p>' +
                '<p class="text-2xl font-black">' +
                orders.length +
                '</p></div>' +

                '<div class="bg-emerald-50 rounded-xl p-4 text-center">' +
                '<p class="text-xs">إجمالي المبيعات</p>' +
                '<p class="text-2xl font-black">' +
                _fmtNum(totalSales) +
                ' EGP</p></div>' +

                '<div class="bg-amber-50 rounded-xl p-4 text-center">' +
                '<p class="text-xs">متوسط الأوردر</p>' +
                '<p class="text-2xl font-black">' +
                _fmtNum(average) +
                ' EGP</p></div>' +

                '</div></div>';
        }

        if (
            selectedTypes.indexOf(
                'sales-by-customer'
            ) !== -1
        ) {
            var customerMap = {};

            orders.forEach(function(order) {
                var cid =
                    order.customer_id ||
                    order.customer_name ||
                    'غير محدد';

                if (!customerMap[cid]) {
                    customerMap[cid] = {
                        name:
                            order.customer_name ||
                            cid,
                        count: 0,
                        total: 0
                    };
                }

                customerMap[cid].count++;
                customerMap[cid].total +=
                    Number(
                        order.total_amount
                    ) || 0;
            });

            var customerArr =
                Object.keys(customerMap)
                    .map(function(k) {
                        return customerMap[k];
                    })
                    .sort(function(a, b) {
                        return b.total - a.total;
                    })
                    .slice(0, 20);

            html +=
                '<div class="bg-white rounded-2xl shadow-sm border p-5">' +
                '<h3 class="font-black text-lg mb-3">' +
                'المبيعات حسب العميل' +
                '</h3>' +
                '<table class="w-full text-sm">' +
                '<thead><tr class="bg-gray-50">' +
                '<th class="p-2">العميل</th>' +
                '<th class="p-2 text-center">الأوردرات</th>' +
                '<th class="p-2 text-center">الإجمالي</th>' +
                '</tr></thead><tbody>';

            customerArr.forEach(function(row) {
                html +=
                    '<tr class="border-t">' +
                    '<td class="p-2 font-semibold">' +
                    _esc(row.name) +
                    '</td>' +
                    '<td class="p-2 text-center">' +
                    row.count +
                    '</td>' +
                    '<td class="p-2 text-center font-bold">' +
                    _fmtNum(row.total) +
                    ' EGP</td>' +
                    '</tr>';
            });

            html +=
                '</tbody></table>' +
                '</div>';

            if (!customerArr.length) {
                html +=
                    '<div class="bg-white rounded-xl p-5 text-center text-gray-500">' +
                    'لا توجد بيانات مبيعات للعملاء' +
                    '</div>';
            }
        }

        if (
            selectedTypes.indexOf(
                'sales-by-item'
            ) !== -1
        ) {
            var itemSalesMap = {};

            details.forEach(function(row) {
                if (!row || !row.item_code) {
                    return;
                }

                if (!itemSalesMap[row.item_code]) {
                    itemSalesMap[row.item_code] = {
                        name:
                            row.item_name ||
